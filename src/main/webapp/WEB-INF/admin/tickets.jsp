<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f4f6fa">
    <title>Hỗ trợ khách hàng · PrintKraft Admin</title>
    <style>
        :root{color-scheme:light;--paper:#f4f6fa;--surface:#fff;--ink:#172033;--muted:#687386;--line:#e3e8f0;--violet:#5546d8;--sidebar:#172238;--shadow:0 8px 24px rgba(23,32,51,.045)}
        *{box-sizing:border-box}html{min-width:320px;min-height:100%;scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:13px/1.5 "DM Sans","Segoe UI",Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}button,a{-webkit-tap-highlight-color:transparent}.support-admin-shell{min-height:100vh;display:grid;grid-template-columns:254px minmax(0,1fr)}
        .support-sidebar{position:sticky;top:0;height:100vh;min-height:100vh;overflow:auto;display:flex;flex-direction:column;padding:21px 14px 14px;background:var(--sidebar);border-right:1px solid #ffffff0d;color:#fff}.support-brand{display:flex;align-items:center;gap:11px;min-width:222px;padding:1px 9px 22px}.support-brand-mark{position:relative;width:36px;height:36px;flex:0 0 36px;border:1px solid #b4abff66;border-radius:11px;background:linear-gradient(145deg,#6b5de1,#4c41b5);box-shadow:0 6px 15px #0c142666;transform:rotate(-5deg)}.support-brand-mark i{position:absolute;display:block;width:10px;height:10px;border-radius:3px;background:#fff;transform:rotate(7deg)}.support-brand-mark i:nth-child(1){left:7px;top:7px;opacity:.97}.support-brand-mark i:nth-child(2){right:6px;top:7px;opacity:.68}.support-brand-mark i:nth-child(3){left:12px;bottom:5px;opacity:.83}.support-brand-copy{display:grid;line-height:1.12}.support-brand-copy strong{font:700 19px/1 "Space Grotesk","Segoe UI",sans-serif;letter-spacing:-.8px}.support-brand-copy strong span{color:#53c5ca}.support-brand-copy small{margin-top:6px;color:#aeb9cb;font-size:8px;font-weight:700;letter-spacing:1.1px}.support-workspace{display:flex;align-items:center;gap:10px;width:100%;min-width:224px;padding:10px;border:1px solid #ffffff17;border-radius:12px;background:#ffffff08}.support-workspace-icon{width:34px;height:34px;display:grid;place-items:center;border:1px solid #8c81ee77;border-radius:10px;background:#7062dc26;color:#c1baff;font-size:17px}.support-workspace-copy{display:grid;gap:2px}.support-workspace-copy small{color:#b2bdd0;font-size:10px}.support-workspace-copy strong{font-size:12px;font-weight:600}.support-nav{overflow:auto;margin:17px -3px 10px;padding:0 3px;scrollbar-width:thin;scrollbar-color:#ffffff20 transparent}.support-nav-list{display:grid;gap:0}.support-nav-label{padding:0 12px 8px;color:#a2aec1;font-size:9px;line-height:1;font-weight:700;letter-spacing:.9px;text-transform:uppercase}.support-nav-link{position:relative;display:flex;align-items:center;gap:11px;min-height:42px;margin:3px 0;padding:0 11px;border:1px solid transparent;border-radius:10px;color:#c4ccda;font-size:12px;font-weight:550;white-space:nowrap;transition:background .16s,color .16s,border-color .16s}.support-nav-link:hover{color:#fff;background:#ffffff0b}.support-nav-link.active{color:#fff;background:#ffffff12;border-color:#ffffff16;box-shadow:inset 3px 0 0 #8b80f1}.support-nav-icon{display:grid;place-items:center;width:19px;flex:0 0 19px;font-size:16px;color:inherit}.support-sidebar-bottom{margin-top:auto;min-width:224px}.support-admin-ident{display:flex;align-items:center;gap:9px;min-width:0;padding:14px 8px 11px;border-top:1px solid #ffffff19;color:#c8d0df;font-size:10px}.support-avatar{width:31px;height:31px;display:grid;place-items:center;flex:0 0 31px;border-radius:10px;background:#6458c9;color:#f1efff;font-size:10px;font-weight:750}.support-admin-ident-copy{min-width:0;display:grid;gap:2px}.support-admin-ident-copy strong{color:#f1f4f9;font-size:11px;font-weight:650}.support-admin-ident-copy small{color:#a8b4c8;font-size:9px}.support-logout-form{margin-top:1px;padding-top:10px;border-top:1px solid #ffffff19}.support-logout{display:flex;align-items:center;gap:10px;width:100%;min-height:40px;padding:0 10px;border:1px solid transparent;border-radius:9px;background:transparent;color:#d3dbea;font-size:11px;font-weight:620;text-align:left}.support-logout:hover{background:#ffffff0c;border-color:#ffffff12;color:white}
        .support-main{min-width:0;min-height:100vh}.support-topbar{position:sticky;top:0;z-index:10;height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 34px;border-bottom:1px solid var(--line);background:#ffffffed;backdrop-filter:blur(14px)}.support-crumbs{display:flex;align-items:center;gap:9px;min-width:0;color:#79859a;font-size:11px;white-space:nowrap}.support-crumbs .crumb-chevron{color:#9da7b7;font-size:17px}.support-crumbs strong{color:var(--ink);font-size:12px;font-weight:700}.support-top-profile{display:flex;align-items:center;gap:9px}.support-top-avatar{width:31px;height:31px;display:grid;place-items:center;border-radius:10px;background:#6458c9;color:#f1efff;font-size:10px;font-weight:750}.support-top-profile-copy{display:grid;gap:2px}.support-top-profile-copy strong{color:#3d475a;font-size:11px}.support-top-profile-copy small{color:#8993a5;font-size:9px}.support-content{width:min(100%,1600px);margin:0 auto;padding:29px 34px 24px}.support-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}.support-eyebrow{margin-bottom:7px;color:#6557d5;font-size:9px;font-weight:800;letter-spacing:1.35px;text-transform:uppercase}.support-heading h1{margin:0;color:#172033;font:700 clamp(25px,2.2vw,32px)/1.15 "Space Grotesk","Segoe UI",sans-serif;letter-spacing:-.8px}.support-heading p{max-width:690px;margin:9px 0 0;color:#758096;font-size:12px;line-height:1.65}.support-heading-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--line);border-radius:11px;background:#fff;color:#687386;font-size:11px;font-weight:700;white-space:nowrap}.support-heading-badge span{width:7px;height:7px;border-radius:50%;background:#6b5de1;box-shadow:0 0 0 3px #6b5de11b}
        .support-alert{margin:0 0 15px;padding:12px 14px;border:1px solid;border-radius:11px;font-size:12px}.support-alert.ok{border-color:#bcead6;background:#edfbf5;color:#126b4b}.support-alert.error{border-color:#ffd4d9;background:#fff1f3;color:#a52d3e}.support-filter-panel,.support-panel{min-width:0;border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:var(--shadow)}.support-filter-panel{margin-bottom:17px;padding:16px}.support-filter-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}.support-filter-head h2,.support-panel-head h2{margin:0;color:#202b40;font-size:13px;font-weight:800}.support-filter-head p,.support-panel-head p{margin:4px 0 0;color:#8791a4;font-size:10px}.support-filter-form{display:grid;grid-template-columns:minmax(180px,1.8fr) repeat(2,minmax(145px,1fr)) auto;align-items:end;gap:11px}.support-field{display:grid;gap:6px;min-width:0}.support-field label,.support-field>span{color:#667287;font-size:10px;font-weight:750}.support-field input,.support-field select,.support-field textarea{width:100%;min-width:0;border:1px solid #dfe4ed;border-radius:9px;background:#fff;color:#263149;outline:none}.support-field input,.support-field select{height:40px;padding:0 10px}.support-field textarea{min-height:94px;padding:10px;resize:vertical}.support-field input:focus,.support-field select:focus,.support-field textarea:focus{border-color:#978fe9;box-shadow:0 0 0 3px #6e62d916}.support-primary-button,.support-secondary-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:0 14px;border:1px solid transparent;border-radius:9px;font-size:11px;font-weight:750;white-space:nowrap;transition:background .15s,border-color .15s}.support-primary-button{background:#5546d8;color:#fff;box-shadow:0 5px 13px #5546d81b}.support-primary-button:hover{background:#4335b8}.support-secondary-button{border-color:#dfe4ed;background:#fff;color:#515d72}.support-secondary-button:hover{background:#f8f9fc;border-color:#cfd6e4}
        .support-ticket-grid{display:grid;grid-template-columns:minmax(290px,.88fr) minmax(360px,1.12fr);align-items:start;gap:16px}.support-panel{overflow:hidden}.support-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:17px 18px;border-bottom:1px solid #edf0f5}.support-count{display:inline-flex;align-items:center;justify-content:center;min-width:27px;height:25px;padding:0 7px;border:1px solid #e4e1ff;border-radius:8px;background:#f2f0ff;color:#5e50d0;font-size:10px;font-weight:800}.support-ticket-list{display:grid;gap:9px;padding:12px}.support-ticket-card{min-width:0;padding:13px;border:1px solid #e5e9f1;border-radius:12px;background:#fff;transition:border-color .15s,background .15s}.support-ticket-card:hover{border-color:#c9c3fb}.support-ticket-card.active{border-color:#aaa1f5;background:#faf9ff;box-shadow:inset 3px 0 0 #786be3}.support-ticket-top{display:flex;align-items:flex-start;justify-content:space-between;gap:9px}.support-ticket-code{color:#665bd0;font-size:10px;font-weight:850;letter-spacing:.3px}.support-status{display:inline-flex;align-items:center;max-width:53%;padding:4px 7px;border-radius:7px;background:#f0f2f6;color:#657086;font-size:9px;font-weight:800;text-align:center;overflow-wrap:anywhere}.status-OPEN,.status-IN_PROGRESS{background:#fff4e4;color:#9a5d0b}.status-WAITING_CUSTOMER{background:#eaf3ff;color:#2865a7}.status-RESOLVED,.status-CLOSED{background:#e8f8f0;color:#187653}.support-ticket-card h3{margin:8px 0 5px;color:#202b40;font-size:12px;font-weight:800;line-height:1.45;overflow-wrap:anywhere}.support-ticket-customer{margin:0;color:#687386;font-size:10px;overflow-wrap:anywhere}.support-ticket-meta{display:flex;align-items:center;flex-wrap:wrap;gap:6px 11px;margin-top:10px;color:#8993a5;font-size:10px}.support-priority{display:inline-flex;align-items:center;gap:5px}.support-priority:before{content:"";width:6px;height:6px;border-radius:50%;background:#a1a9b8}.priority-HIGH:before{background:#df596b}.priority-NORMAL:before{background:#d49a36}.priority-LOW:before{background:#2a9a73}.support-ticket-action{display:inline-flex;align-items:center;gap:5px;margin-top:11px;color:#5b4ed0;font-size:10px;font-weight:800}.support-empty{padding:36px 15px;color:#8a94a6;font-size:11px;text-align:center}.support-detail-body{padding:18px}.support-detail-customer{margin:5px 0 0;color:#758096;font-size:11px;overflow-wrap:anywhere}.support-detail-facts{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0 16px}.support-detail-fact{padding:6px 8px;border:1px solid #edf0f5;border-radius:8px;background:#fafbfe;color:#69758a;font-size:10px}.support-conversation{display:grid;gap:9px;max-height:340px;overflow:auto;margin-bottom:17px;padding:4px 2px 11px;border-bottom:1px solid #edf0f5}.support-message{padding:11px 12px;border:1px solid #e7eaf2;border-radius:10px;background:#fafbfe;overflow-wrap:anywhere}.support-message.internal{border-color:#f1dfb8;background:#fffaf0}.support-message-head{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:4px 10px;color:#374257;font-size:10px;font-weight:800}.support-message-head time{color:#929bad;font-size:9px;font-weight:500}.support-message p{margin:7px 0 0;color:#566176;font-size:11px;line-height:1.65;white-space:pre-wrap}.support-update-form{display:grid;gap:12px}.support-update-form .two-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.support-checkbox{display:flex;align-items:center;gap:8px;color:#657086;font-size:10px}.support-checkbox input{accent-color:#5b4ed0}.support-update-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap}.support-footer{display:flex;justify-content:space-between;gap:10px;margin-top:22px;padding-top:16px;border-top:1px solid #e4e8f0;color:#9aa3b3;font-size:10px}
        @media(max-width:1120px){.support-ticket-grid{grid-template-columns:minmax(0,1fr)}.support-filter-form{grid-template-columns:repeat(2,minmax(0,1fr))}.support-filter-form .support-filter-submit{grid-column:1/-1}.support-content{padding:24px 22px}}
        @media(max-width:900px){.support-admin-shell{grid-template-columns:minmax(0,1fr)}.support-sidebar{position:relative;height:auto;min-height:0;overflow:visible;padding:13px 16px 10px;gap:12px}.support-brand{padding:0 2px 4px}.support-workspace,.support-sidebar-bottom{display:none}.support-nav{margin:2px 0 0;padding:0 0 4px;overflow-x:auto;overflow-y:hidden}.support-nav-label{display:none}.support-nav-list{display:flex;gap:5px;min-width:max-content}.support-nav-link{min-height:36px;margin:0;padding:0 10px;font-size:10px}.support-nav-icon{width:auto;flex-basis:auto}.support-topbar{height:58px;padding:0 20px}.support-content{padding:22px 20px}.support-heading{align-items:flex-start}}
        @media(max-width:560px){.support-topbar{padding:0 13px}.support-top-profile-copy{display:none}.support-content{padding:18px 12px}.support-heading{display:block}.support-heading-badge{margin-top:13px}.support-filter-panel{padding:12px}.support-filter-form{grid-template-columns:minmax(0,1fr)}.support-filter-form .support-filter-submit{grid-column:auto}.support-panel-head{padding:14px}.support-ticket-list{padding:9px}.support-detail-body{padding:13px}.support-update-form .two-fields{grid-template-columns:minmax(0,1fr)}.support-footer{font-size:9px}}
    </style>
</head>
<body>
<div class="support-admin-shell">
    <aside class="support-sidebar" aria-label="Điều hướng quản trị">
        <a class="support-brand" href="${pageContext.request.contextPath}/admin" aria-label="PrintKraft Admin">
            <span class="support-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="support-brand-copy"><strong>PrintKraft<span>.</span></strong><small>MARKETPLACE ADMIN</small></span>
        </a>
        <div class="support-workspace"><span class="support-workspace-icon" aria-hidden="true">◇</span><span class="support-workspace-copy"><small>Quản trị vận hành</small><strong>Marketplace</strong></span></div>
        <nav class="support-nav" aria-label="Quản lý marketplace">
            <div class="support-nav-label">Quản lý marketplace</div>
            <div class="support-nav-list">
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin"><span class="support-nav-icon">▦</span><span>Dashboard</span></a>
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin/users"><span class="support-nav-icon">♙</span><span>Người dùng</span></a>
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin/sellers"><span class="support-nav-icon">⌂</span><span>Seller / Xưởng in</span></a>
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin/products"><span class="support-nav-icon">◇</span><span>Sản phẩm</span></a>
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin/orders"><span class="support-nav-icon">▣</span><span>Đơn hàng</span></a>
                <a class="support-nav-link" href="${pageContext.request.contextPath}/admin/statistics"><span class="support-nav-icon">▥</span><span>Thống kê</span></a>
                <a class="support-nav-link active" href="${pageContext.request.contextPath}/admin/tickets" aria-current="page"><span class="support-nav-icon">☏</span><span>Hỗ trợ khách hàng</span></a>
            </div>
        </nav>
        <div class="support-sidebar-bottom">
            <div class="support-admin-ident"><span class="support-avatar" aria-hidden="true">A</span><span class="support-admin-ident-copy"><strong>Quản trị viên</strong><small>Marketplace Admin</small></span></div>
            <form class="support-logout-form" method="post" action="${pageContext.request.contextPath}/logout">
                <input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>">
                <button class="support-logout" type="submit"><span aria-hidden="true">↗</span>Đăng xuất</button>
            </form>
        </div>
    </aside>
    <main class="support-main">
        <header class="support-topbar"><div class="support-crumbs"><span>PrintKraft</span><span class="crumb-chevron" aria-hidden="true">›</span><strong>Hỗ trợ khách hàng</strong></div><div class="support-top-profile"><span class="support-top-avatar" aria-hidden="true">A</span><span class="support-top-profile-copy"><strong>Quản trị viên</strong><small>Marketplace Admin</small></span></div></header>
        <div class="support-content">
            <div class="support-heading"><div><div class="support-eyebrow">Chăm sóc khách hàng</div><h1>Hỗ trợ khách hàng</h1><p>Tiếp nhận yêu cầu, theo dõi khiếu nại và phản hồi khách hàng trong cùng một không gian quản trị.</p></div><div class="support-heading-badge"><span></span>Quản lý ticket</div></div>
            <c:if test="${param.updated == '1'}"><div class="support-alert ok" role="status">Đã cập nhật ticket thành công.</div></c:if>
            <c:if test="${not empty error}"><div class="support-alert error" role="alert"><c:out value="${error}"/></div></c:if>
            <section class="support-filter-panel">
                <div class="support-filter-head"><div><h2>Lọc yêu cầu hỗ trợ</h2><p>Tìm nhanh theo mã ticket, tiêu đề hoặc thông tin khách hàng.</p></div></div>
                <form method="get" action="${pageContext.request.contextPath}/admin/tickets" class="support-filter-form">
                    <label class="support-field"><span>Từ khóa</span><input type="search" name="q" value="<c:out value='${param.q}'/>" placeholder="Mã, tiêu đề, khách hàng"></label>
                    <label class="support-field"><span>Trạng thái</span><select name="status"><option value="">Tất cả trạng thái</option><option value="OPEN" <c:if test="${param.status == 'OPEN'}">selected</c:if>>Mới mở</option><option value="IN_PROGRESS" <c:if test="${param.status == 'IN_PROGRESS'}">selected</c:if>>Đang xử lý</option><option value="WAITING_CUSTOMER" <c:if test="${param.status == 'WAITING_CUSTOMER'}">selected</c:if>>Chờ khách hàng</option><option value="RESOLVED" <c:if test="${param.status == 'RESOLVED'}">selected</c:if>>Đã giải quyết</option><option value="CLOSED" <c:if test="${param.status == 'CLOSED'}">selected</c:if>>Đã đóng</option></select></label>
                    <label class="support-field"><span>Mức ưu tiên</span><select name="priority"><option value="">Tất cả mức ưu tiên</option><option value="HIGH" <c:if test="${param.priority == 'HIGH'}">selected</c:if>>Cao</option><option value="NORMAL" <c:if test="${param.priority == 'NORMAL'}">selected</c:if>>Bình thường</option><option value="LOW" <c:if test="${param.priority == 'LOW'}">selected</c:if>>Thấp</option></select></label>
                    <button class="support-primary-button support-filter-submit" type="submit">⌕&nbsp; Áp dụng bộ lọc</button>
                </form>
            </section>
            <div class="support-ticket-grid">
                <section class="support-panel">
                    <div class="support-panel-head"><div><h2>Danh sách yêu cầu</h2><p>Các ticket khớp với bộ lọc hiện tại.</p></div><span class="support-count"><c:out value="${fn:length(tickets)}"/></span></div>
                    <div class="support-ticket-list">
                        <c:choose>
                            <c:when test="${empty tickets}"><div class="support-empty">Không tìm thấy yêu cầu phù hợp.<br>Thử đổi trạng thái hoặc từ khóa tìm kiếm.</div></c:when>
                            <c:otherwise><c:forEach var="t" items="${tickets}">
                                <article class="support-ticket-card <c:if test='${ticket.id == t.id}'>active</c:if>">
                                    <div class="support-ticket-top"><span class="support-ticket-code"><c:out value="${t.code}"/></span><span class="support-status status-<c:out value='${t.status}'/>" ><c:out value="${t.status}"/></span></div>
                                    <h3><c:out value="${t.subject}"/></h3>
                                    <p class="support-ticket-customer"><c:out value="${t.customer}"/> · <c:out value="${t.email}"/></p>
                                    <div class="support-ticket-meta"><span class="support-priority priority-<c:out value='${t.priority}'/>">Ưu tiên: <c:out value="${t.priority}"/></span><span>SLA: <c:out value="${t.slaDueAt}"/></span></div>
                                    <a class="support-ticket-action" href="${pageContext.request.contextPath}/admin/tickets?id=${t.id}&amp;status=<c:out value='${param.status}'/>&amp;priority=<c:out value='${param.priority}'/>&amp;q=<c:out value='${param.q}'/>">Xử lý ticket <span aria-hidden="true">→</span></a>
                                </article>
                            </c:forEach></c:otherwise>
                        </c:choose>
                    </div>
                </section>
                <section class="support-panel">
                    <div class="support-panel-head"><div><h2>Chi tiết và xử lý</h2><p>Trao đổi với khách hàng, cập nhật trạng thái và phân công người phụ trách.</p></div></div>
                    <div class="support-detail-body">
                        <c:choose>
                            <c:when test="${empty ticket}"><div class="support-empty">Chọn một ticket ở danh sách bên trái để xem nội dung và xử lý.</div></c:when>
                            <c:otherwise>
                                <div class="support-ticket-code"><c:out value="${ticket.code}"/></div><h3 style="margin:6px 0 0;font-size:17px;line-height:1.4;overflow-wrap:anywhere;color:#202b40"><c:out value="${ticket.subject}"/></h3>
                                <p class="support-detail-customer">Khách hàng: <c:out value="${ticket.customer}"/> · <c:out value="${ticket.email}"/></p>
                                <div class="support-detail-facts"><span class="support-detail-fact">Loại: <c:out value="${ticket.category}"/></span><span class="support-detail-fact">Đơn hàng: <c:out value="${ticket.orderId}"/></span><span class="support-detail-fact">Xưởng: <c:out value="${ticket.shopId}"/></span></div>
                                <div class="support-conversation" aria-label="Lịch sử hội thoại">
                                    <c:choose><c:when test="${empty ticketMessages}"><div class="support-empty">Chưa có tin nhắn trong ticket này.</div></c:when><c:otherwise><c:forEach var="m" items="${ticketMessages}"><article class="support-message <c:if test='${m.internal}'>internal</c:if>"><div class="support-message-head"><span><c:out value="${m.sender}"/> · <c:out value="${m.role}"/><c:if test="${m.internal}"> · Ghi chú nội bộ</c:if></span><time><c:out value="${m.createdAt}"/></time></div><p><c:out value="${m.body}"/></p></article></c:forEach></c:otherwise></c:choose>
                                </div>
                                <form method="post" action="${pageContext.request.contextPath}/admin/tickets" class="support-update-form">
                                    <input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="ticketId" value="<c:out value='${ticket.id}'/>">
                                    <div class="two-fields">
                                        <label class="support-field"><span>Trạng thái</span><select name="status"><option value="OPEN" <c:if test="${ticket.status == 'OPEN'}">selected</c:if>>Mới mở</option><option value="IN_PROGRESS" <c:if test="${ticket.status == 'IN_PROGRESS'}">selected</c:if>>Đang xử lý</option><option value="WAITING_CUSTOMER" <c:if test="${ticket.status == 'WAITING_CUSTOMER'}">selected</c:if>>Chờ khách hàng</option><option value="RESOLVED" <c:if test="${ticket.status == 'RESOLVED'}">selected</c:if>>Đã giải quyết</option><option value="CLOSED" <c:if test="${ticket.status == 'CLOSED'}">selected</c:if>>Đã đóng</option></select></label>
                                        <label class="support-field"><span>Mức ưu tiên</span><select name="priority"><option value="LOW" <c:if test="${ticket.priority == 'LOW'}">selected</c:if>>Thấp</option><option value="NORMAL" <c:if test="${ticket.priority == 'NORMAL'}">selected</c:if>>Bình thường</option><option value="HIGH" <c:if test="${ticket.priority == 'HIGH'}">selected</c:if>>Cao</option></select></label>
                                    </div>
                                    <label class="support-field"><span>Giao cho Admin ID</span><input type="number" name="assignedAdminId" min="1" value="<c:out value='${ticket.assignedAdminId}'/>" placeholder="Để trống nếu chưa giao"></label>
                                    <label class="support-field"><span>Phản hồi khách hàng hoặc ghi chú</span><textarea name="reply" rows="4" maxlength="5000" placeholder="Nhập nội dung phản hồi; để trống nếu chỉ cập nhật trạng thái"></textarea></label>
                                    <label class="support-checkbox"><input type="checkbox" name="internal" value="1"> Ghi chú nội bộ (không gửi cho khách)</label>
                                    <div class="support-update-actions"><button class="support-secondary-button" type="reset">Làm mới biểu mẫu</button><button class="support-primary-button" type="submit">Lưu cập nhật</button></div>
                                </form>
                            </c:otherwise>
                        </c:choose>
                    </div>
                </section>
            </div>
            <footer class="support-footer"><span>PrintKraft Marketplace</span><span>Khu vực quản trị · Hỗ trợ khách hàng</span></footer>
        </div>
    </main>
</div>
</body>
</html>
