<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Hàng đợi hỗ trợ - PrintKraft Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/cus_home.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><style>.admin-ticket-grid{display:grid;grid-template-columns:minmax(300px,.95fr) minmax(320px,1.05fr);gap:18px}.admin-ticket-list{display:grid;gap:10px}.admin-ticket{padding:14px;border:1px solid #e5e7eb;border-radius:12px}.admin-ticket.active{border-color:#b8860b;background:#fffdf6}.admin-ticket label{display:grid;gap:6px;margin:10px 0}.admin-ticket input,.admin-ticket select,.admin-ticket textarea{width:100%;padding:9px;border:1px solid #d1d5db;border-radius:8px}@media(max-width:850px){.admin-ticket-grid{grid-template-columns:1fr}}</style></head><body class="customer-account-body"><main class="account-page"><div class="shop-heading"><div><div class="eyebrow-line">QUẢN TRỊ</div><h1>Hàng đợi hỗ trợ và khiếu nại</h1><p>Lọc theo trạng thái/mức ưu tiên; xem nội dung liên quan và phản hồi khách.</p></div><a class="account-outline-button" href="${pageContext.request.contextPath}/admin/dashboard">Quay lại Admin</a></div>
<c:if test="${param.updated == '1'}"><div class="alert alert-ok" role="status">Đã cập nhật ticket.</div></c:if><c:if test="${not empty error}"><div class="alert alert-err" role="alert"><c:out value="${error}"/></div></c:if>
<form method="get" action="${pageContext.request.contextPath}/admin/tickets" class="account-form" style="display:flex;gap:10px;flex-wrap:wrap;margin:12px 0"><label>Từ khóa<input type="search" name="q" value="<c:out value='${param.q}'/>" placeholder="Mã, tiêu đề, khách hàng"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="OPEN" <c:if test="${param.status == 'OPEN'}">selected</c:if>>OPEN</option><option value="IN_PROGRESS" <c:if test="${param.status == 'IN_PROGRESS'}">selected</c:if>>IN_PROGRESS</option><option value="WAITING_CUSTOMER" <c:if test="${param.status == 'WAITING_CUSTOMER'}">selected</c:if>>WAITING_CUSTOMER</option><option value="RESOLVED" <c:if test="${param.status == 'RESOLVED'}">selected</c:if>>RESOLVED</option><option value="CLOSED" <c:if test="${param.status == 'CLOSED'}">selected</c:if>>CLOSED</option></select></label><label>Ưu tiên<select name="priority"><option value="">Tất cả</option><option value="HIGH">Cao</option><option value="NORMAL">Bình thường</option><option value="LOW">Thấp</option></select></label><button class="account-outline-button" type="submit">Lọc</button></form>
<div class="admin-ticket-grid"><section class="account-panel"><h2>Danh sách ticket (<c:out value="${fn:length(tickets)}"/>)</h2><div class="admin-ticket-list"><c:choose><c:when test="${empty tickets}"><p>Không có ticket phù hợp.</p></c:when><c:otherwise><c:forEach var="t" items="${tickets}"><article class="admin-ticket <c:if test='${ticket.id == t.id}'>active</c:if>"><b><c:out value="${t.code}"/> · <c:out value="${t.subject}"/></b><p><c:out value="${t.customer}"/> — <c:out value="${t.email}"/></p><p>Trạng thái: <c:out value="${t.status}"/> · Ưu tiên: <c:out value="${t.priority}"/></p><p>SLA: <c:out value="${t.slaDueAt}"/></p><a class="account-outline-button" href="${pageContext.request.contextPath}/admin/tickets?id=${t.id}&amp;status=${param.status}&amp;priority=${param.priority}&amp;q=${param.q}">Xử lý ticket</a></article></c:forEach></c:otherwise></c:choose></div></section>
<section class="account-panel"><c:choose><c:when test="${empty ticket}"><h2>Chi tiết ticket</h2><p>Chọn một ticket bên trái để xem hội thoại và xử lý.</p></c:when><c:otherwise><h2><c:out value="${ticket.code}"/> · <c:out value="${ticket.subject}"/></h2><p>Khách: <c:out value="${ticket.customer}"/> (<c:out value="${ticket.email}"/>)</p><p>Loại: <c:out value="${ticket.category}"/> · Đơn ID: <c:out value="${ticket.orderId}"/> · Xưởng ID: <c:out value="${ticket.shopId}"/></p><div class="account-ticket-chat"><c:forEach var="m" items="${ticketMessages}"><article class="account-ticket-message"><b><c:out value="${m.sender}"/> · <c:out value="${m.role}"/> <c:if test="${m.internal}">(Ghi chú nội bộ)</c:if></b><div class="account-message-meta"><c:out value="${m.createdAt}"/></div><p><c:out value="${m.body}"/></p></article></c:forEach></div><form method="post" action="${pageContext.request.contextPath}/admin/tickets" class="account-form"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="ticketId" value="${ticket.id}"><label>Trạng thái<select name="status"><option value="OPEN" <c:if test="${ticket.status == 'OPEN'}">selected</c:if>>OPEN</option><option value="IN_PROGRESS" <c:if test="${ticket.status == 'IN_PROGRESS'}">selected</c:if>>IN_PROGRESS</option><option value="WAITING_CUSTOMER" <c:if test="${ticket.status == 'WAITING_CUSTOMER'}">selected</c:if>>WAITING_CUSTOMER</option><option value="RESOLVED" <c:if test="${ticket.status == 'RESOLVED'}">selected</c:if>>RESOLVED</option><option value="CLOSED" <c:if test="${ticket.status == 'CLOSED'}">selected</c:if>>CLOSED</option></select></label><label>Mức ưu tiên<select name="priority"><option value="LOW" <c:if test="${ticket.priority == 'LOW'}">selected</c:if>>LOW</option><option value="NORMAL" <c:if test="${ticket.priority == 'NORMAL'}">selected</c:if>>NORMAL</option><option value="HIGH" <c:if test="${ticket.priority == 'HIGH'}">selected</c:if>>HIGH</option></select></label><label>Giao cho Admin ID<input type="number" name="assignedAdminId" min="1" value="<c:out value='${ticket.assignedAdminId}'/>" placeholder="Để trống nếu chưa giao"></label><label>Phản hồi khách hoặc ghi chú<textarea name="reply" rows="4" maxlength="5000" placeholder="Để trống nếu chỉ cập nhật trạng thái"></textarea></label><label><input type="checkbox" name="internal" value="1"> Ghi chú nội bộ (không gửi cho khách)</label><button type="submit" class="btn-primary">Lưu xử lý</button></form></c:otherwise></c:choose></section></div></main></body></html>
