<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gửi yêu cầu in 3D | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Yêu cầu in 3D</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">CUSTOM 3D PRINT</p><h1>Gửi mô hình cần in</h1><p>Tải lên file mô hình, chọn vật liệu và thông số để xưởng tiếp nhận, kiểm tra và phản hồi báo giá.</p></div><a class="uv2-button is-light" href="${pageContext.request.contextPath}/my-designs">Yêu cầu đã gửi</a></div>
<c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-design-layout"><section class="uv2-panel"><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/design-request" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><label class="uv2-upload-zone"> <span class="uv2-upload-icon">＋</span><b>Chọn file mô hình 3D</b><small>STL, OBJ, STEP, STP hoặc 3MF · Tối đa 50 MB</small><input type="file" name="modelFile" accept=".stl,.obj,.step,.stp,.3mf" required></label>
<div class="uv2-form-grid"><label>Công nghệ in<select name="technology" required><option value="FDM">FDM – Sợi nhựa</option><option value="SLA">SLA – Resin quang hóa</option></select></label><label>Vật liệu<select name="material" required><option value="PLA">PLA</option><option value="ABS">ABS</option><option value="PETG">PETG</option><option value="TPU">TPU dẻo</option><option value="RESIN">Resin</option></select></label><label>Số lượng<input type="number" name="quantity" min="1" max="100" value="1" required></label><label>Rộng (mm)<input type="number" name="widthMm" min="0.01" max="1000" step="0.01" placeholder="Tùy chọn"></label><label>Cao (mm)<input type="number" name="heightMm" min="0.01" max="1000" step="0.01" placeholder="Tùy chọn"></label><label>Sâu (mm)<input type="number" name="depthMm" min="0.01" max="1000" step="0.01" placeholder="Tùy chọn"></label></div>
<label>Yêu cầu thêm<textarea name="customerNote" rows="4" maxlength="1000" placeholder="Màu sắc, độ hoàn thiện, mục đích sử dụng hoặc lưu ý kỹ thuật..."></textarea></label>
<div class="uv2-info-note"><b>Quy trình tiếp nhận</b><ol><li>PrintKraft nhận file và thông tin mô hình.</li><li>Xưởng kiểm tra khả năng in, vật liệu và thông số.</li><li>Trạng thái và báo giá (nếu có) sẽ được cập nhật trong danh sách yêu cầu.</li></ol></div>
<button class="uv2-button is-primary">Gửi yêu cầu in 3D</button></form></section><aside class="uv2-panel uv2-design-aside"><p class="uv2-eyebrow">LƯU Ý KHI GỬI FILE</p><h2>Chuẩn bị mô hình tốt hơn</h2><ul><li>Kiểm tra mô hình không bị hở mặt hoặc lỗi hình học.</li><li>Đảm bảo kích thước mô hình đúng với nhu cầu thực tế.</li><li>Không tải lên nội dung bạn không có quyền sử dụng.</li><li>Không gửi thông tin cá nhân nhạy cảm trong ghi chú.</li></ul><a href="${pageContext.request.contextPath}/my-designs">Theo dõi yêu cầu đã gửi →</a></aside></div></main><jsp:include page="/customer/footer.jsp"/></body></html>
