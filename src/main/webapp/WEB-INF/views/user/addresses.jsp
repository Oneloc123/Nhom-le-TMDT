<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sổ địa chỉ | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css?v=20261104-account-layout"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/address-picker.css?v=20261125-address"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Sổ địa chỉ</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">GIAO HÀNG NHANH HƠN</p><h1>Sổ địa chỉ</h1><p>Lưu nhiều địa chỉ và chọn địa chỉ mặc định cho lần đặt hàng tiếp theo.</p></div></div>
<c:if test="${param.updated eq '1'}"><div class="uv2-alert is-success">Sổ địa chỉ đã được cập nhật.</div></c:if><c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-account-grid"><jsp:include page="/WEB-INF/views/user/account-sidebar.jsp"/><div class="uv2-content"><div class="uv2-address-layout"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">ĐỊA CHỈ ĐÃ LƯU</p><h2><c:out value="${fn:length(addresses)}"/> địa chỉ</h2></div></div>
<c:choose><c:when test="${empty addresses}"><div class="uv2-empty"><b>Chưa có địa chỉ nào</b><p>Thêm địa chỉ giao hàng đầu tiên của bạn.</p></div></c:when><c:otherwise><div class="uv2-address-list"><c:forEach var="a" items="${addresses}"><article class="uv2-address-card"><div class="uv2-address-card-head"><div><span class="uv2-address-label"><c:out value="${a.label}"/></span><c:if test="${a.is_default}"><span class="uv2-default-pill">Mặc định</span></c:if></div><b><c:out value="${a.recipient_name}"/></b></div><p><c:out value="${a.recipient_phone}"/></p><p><c:out value="${a.address_line}"/><c:if test="${not empty a.ward}">, <c:out value="${a.ward}"/></c:if><c:if test="${not empty a.district}">, <c:out value="${a.district}"/></c:if><c:if test="${not empty a.province}">, <c:out value="${a.province}"/></c:if></p><c:if test="${not empty a.delivery_note}"><small>Ghi chú: <c:out value="${a.delivery_note}"/></small></c:if><div class="uv2-address-actions"><a href="${pageContext.request.contextPath}/addresses?edit=${a.address_id}#address-form">Sửa</a><c:if test="${!a.is_default}"><form method="post" action="${pageContext.request.contextPath}/addresses"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="default"><input type="hidden" name="addressId" value="${a.address_id}"><button>Đặt mặc định</button></form></c:if><form method="post" action="${pageContext.request.contextPath}/addresses" onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?')"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="delete"><input type="hidden" name="addressId" value="${a.address_id}"><button class="is-danger">Xóa</button></form></div></article></c:forEach></div></c:otherwise></c:choose></section>
<section class="uv2-panel" id="address-form"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">THÔNG TIN GIAO NHẬN</p><h2><c:choose><c:when test="${not empty editingAddress}">Chỉnh sửa địa chỉ</c:when><c:otherwise>Thêm địa chỉ mới</c:otherwise></c:choose></h2></div></div>
<form method="post" action="${pageContext.request.contextPath}/addresses" class="uv2-form" data-vn-address-picker><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="addressId" value="<c:out value='${editingAddress.address_id}'/>"><label>Người nhận<input name="recipientName" required maxlength="120" value="<c:out value='${editingAddress.recipient_name}'/>" autocomplete="name"></label><label>Số điện thoại<input name="recipientPhone" required maxlength="25" value="<c:out value='${editingAddress.recipient_phone}'/>" autocomplete="tel"></label><label>Loại địa chỉ<select name="label"><option value="Nhà riêng">Nhà riêng</option><option value="Văn phòng" <c:if test="${editingAddress.label eq 'Văn phòng'}">selected</c:if>>Văn phòng</option><option value="Xưởng" <c:if test="${editingAddress.label eq 'Xưởng'}">selected</c:if>>Xưởng</option><option value="Khác" <c:if test="${editingAddress.label eq 'Khác'}">selected</c:if>>Khác</option></select></label><div class="vn-address-field"><label for="addressProvince">Tỉnh / thành phố</label><select id="addressProvince" data-province-select required><option value="">Đang tải tỉnh/thành…</option></select><input type="hidden" name="province" data-province-value value="<c:out value='${editingAddress.province}'/>"><input type="hidden" name="provinceCode" data-province-code value="<c:out value='${editingAddress.province_code}'/>"><input type="text" data-province-fallback class="vn-address-fallback" placeholder="Nhập tỉnh/thành phố" value="<c:out value='${editingAddress.province}'/>" hidden disabled></div><div class="vn-address-field"><label for="addressWard">Phường / xã</label><select id="addressWard" data-ward-select required disabled><option value="">Chọn tỉnh/thành phố trước</option></select><input type="hidden" name="ward" data-ward-value value="<c:out value='${editingAddress.ward}'/>"><input type="hidden" name="wardCode" data-ward-code value="<c:out value='${editingAddress.ward_code}'/>"><input type="text" data-ward-fallback class="vn-address-fallback" placeholder="Nhập phường/xã" value="<c:out value='${editingAddress.ward}'/>" hidden disabled></div><input type="hidden" name="district" data-district-value value="<c:out value='${editingAddress.district}'/>"><p class="vn-address-api-status" data-address-api-status role="status">Đang tải danh mục địa giới hành chính…</p><p class="vn-address-attribution">Nguồn dữ liệu: <a href="https://diachiviet.com/api-tinh-thanh/" target="_blank" rel="noopener noreferrer">Địa Chỉ Việt</a> · CC BY 4.0</p><label>Địa chỉ cụ thể<input name="addressLine" required maxlength="255" value="<c:out value='${editingAddress.address_line}'/>" placeholder="Số nhà, tên đường..."></label><label>Ghi chú giao hàng<textarea name="deliveryNote" rows="3" maxlength="500"><c:out value="${editingAddress.delivery_note}"/></textarea></label><label class="uv2-check"><input type="checkbox" name="isDefault" value="1" <c:if test="${editingAddress.is_default}">checked</c:if>> Đặt làm địa chỉ mặc định</label><button class="uv2-button is-primary">Lưu địa chỉ</button><c:if test="${not empty editingAddress}"><a class="uv2-cancel-link" href="${pageContext.request.contextPath}/addresses">Hủy chỉnh sửa</a></c:if></form></section></div></div></div></main><script defer src="${pageContext.request.contextPath}/js/address-picker.js?v=20261125-address"></script><jsp:include page="/customer/footer.jsp"/></body></html>