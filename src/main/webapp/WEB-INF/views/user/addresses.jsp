<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sổ địa chỉ | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css?v=20261104-account-layout"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/address-picker.css?v=20261125-address"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account-modals.css?v=20261125-modals"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Sổ địa chỉ</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">GIAO HÀNG NHANH HƠN</p><h1>Sổ địa chỉ</h1><p>Lưu nhiều địa chỉ, chỉnh sửa hoặc chọn địa chỉ mặc định cho các lần đặt hàng.</p></div><button type="button" class="account-modal-button is-primary" data-modal-open="#addressEditorModal" data-address-create>＋ Thêm địa chỉ</button></div>
<c:if test="${param.updated eq '1'}"><div class="uv2-alert is-success">Sổ địa chỉ đã được cập nhật.</div></c:if><c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-account-grid"><jsp:include page="/WEB-INF/views/user/account-sidebar.jsp"/><div class="uv2-content"><div class="uv2-address-layout"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">ĐỊA CHỈ ĐÃ LƯU</p><h2><c:out value="${fn:length(addresses)}"/> địa chỉ</h2></div></div>
<c:choose><c:when test="${empty addresses}"><div class="uv2-empty"><b>Chưa có địa chỉ nào</b><p>Thêm địa chỉ giao hàng đầu tiên của bạn.</p></div></c:when><c:otherwise><div class="uv2-address-list"><c:forEach var="a" items="${addresses}"><article class="uv2-address-card" data-address-card data-address-id="${a.address_id}" data-recipient-name="<c:out value='${a.recipient_name}'/>" data-recipient-phone="<c:out value='${a.recipient_phone}'/>" data-address-label="<c:out value='${a.label}'/>" data-province="<c:out value='${a.province}'/>" data-province-code="<c:out value='${a.province_code}'/>" data-district="<c:out value='${a.district}'/>" data-ward="<c:out value='${a.ward}'/>" data-ward-code="<c:out value='${a.ward_code}'/>" data-address-line="<c:out value='${a.address_line}'/>" data-delivery-note="<c:out value='${a.delivery_note}'/>" data-is-default="${a.is_default}"><div class="uv2-address-card-head"><div><span class="uv2-address-label"><c:out value="${a.label}"/></span><c:if test="${a.is_default}"><span class="uv2-default-pill">Mặc định</span></c:if></div><b><c:out value="${a.recipient_name}"/></b></div><p><c:out value="${a.recipient_phone}"/></p><p><c:out value="${a.address_line}"/><c:if test="${not empty a.ward}">, <c:out value="${a.ward}"/></c:if><c:if test="${not empty a.district}">, <c:out value="${a.district}"/></c:if><c:if test="${not empty a.province}">, <c:out value="${a.province}"/></c:if></p><c:if test="${not empty a.delivery_note}"><small>Ghi chú: <c:out value="${a.delivery_note}"/></small></c:if><div class="uv2-address-actions account-modal-actions"><button type="button" class="account-modal-button is-light" data-modal-open="#addressEditorModal" data-address-edit>Chỉnh sửa</button><c:if test="${!a.is_default}"><button type="button" class="account-modal-button is-light" data-modal-open="#addressDefaultModal" data-address-default>Đặt mặc định</button></c:if><button type="button" class="account-modal-button is-danger" data-modal-open="#addressDeleteModal" data-address-delete>Xóa địa chỉ</button></div></article></c:forEach></div></c:otherwise></c:choose></section>
<section class="uv2-panel uv2-address-help-card"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">GỢI Ý NHANH</p><h2>Quản lý địa chỉ dễ dàng</h2></div></div><p class="uv2-muted">Chọn <b>Thêm địa chỉ</b> để lưu nơi nhận mới. Mỗi thẻ địa chỉ có thể được chỉnh sửa, đặt làm mặc định hoặc xóa bằng các nút riêng.</p><ul class="uv2-address-tip-list"><li><b>Địa chỉ mặc định</b><span>Sẽ được ưu tiên chọn khi đặt hàng nếu bạn chưa chọn địa chỉ khác.</span></li><li><b>Tỉnh/thành và phường/xã</b><span>Chọn theo danh mục để hạn chế sai sót khi giao hàng.</span></li><li><b>Ghi chú giao hàng</b><span>Thêm chỉ dẫn như giờ nhận hàng hoặc vị trí cổng nếu cần.</span></li></ul></section></div></div></div>
<dialog id="addressEditorModal" class="account-modal" data-account-modal data-modal-auto-open="${not empty error or not empty editingAddress ? 'true' : 'false'}" aria-labelledby="addressModalHeading">
    <div class="account-modal-panel">
        <div class="account-modal-header">
            <div class="account-modal-heading"><span class="account-modal-icon" aria-hidden="true">⌖</span><div><h2 id="addressModalHeading" data-address-modal-title><c:choose><c:when test="${not empty editingAddress}">Chỉnh sửa địa chỉ</c:when><c:otherwise>Thêm địa chỉ mới</c:otherwise></c:choose></h2><p>Thông tin này sẽ được dùng khi bạn đặt hàng.</p></div></div>
            <button type="button" class="account-modal-close" data-modal-close aria-label="Đóng">×</button>
        </div>
        <div class="account-modal-scroll">
            <aside class="account-modal-help" id="addressModalHelp" data-modal-help>
                <div class="account-modal-help-title"><span aria-hidden="true">ⓘ</span> Cách sử dụng</div>
                <ol><li>Nhập tên và số điện thoại người nhận.</li><li>Chọn tỉnh/thành phố rồi chọn phường/xã theo danh mục; nếu dịch vụ lỗi, nhập tay theo hướng dẫn trên màn hình.</li><li>Điền số nhà, tên đường và ghi chú giao hàng nếu có.</li><li>Bật “Đặt làm địa chỉ mặc định” để ưu tiên địa chỉ này khi checkout, sau đó nhấn “Lưu địa chỉ”.</li></ol>
            </aside>
            <form id="addressEditorForm" method="post" action="${pageContext.request.contextPath}/addresses" class="account-modal-form" data-vn-address-picker data-address-editor-form>
                <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>">
                <input type="hidden" name="action" value="save">
                <input type="hidden" name="addressId" value="<c:out value='${editingAddress.address_id}'/>">
                <label>Người nhận<input name="recipientName" required maxlength="120" autocomplete="name" value="<c:out value='${not empty param.recipientName ? param.recipientName : editingAddress.recipient_name}'/>"></label>
                <label>Số điện thoại<input name="recipientPhone" required maxlength="25" autocomplete="tel" value="<c:out value='${not empty param.recipientPhone ? param.recipientPhone : editingAddress.recipient_phone}'/>"></label>
                <label>Loại địa chỉ<select name="label"><option value="Nhà riêng" <c:if test="${(not empty param.label and param.label eq 'Nhà riêng') or (empty param.label and (empty editingAddress or editingAddress.label eq 'Nhà riêng'))}">selected</c:if>>Nhà riêng</option><option value="Văn phòng" <c:if test="${(not empty param.label and param.label eq 'Văn phòng') or (empty param.label and editingAddress.label eq 'Văn phòng')}">selected</c:if>>Văn phòng</option><option value="Xưởng" <c:if test="${(not empty param.label and param.label eq 'Xưởng') or (empty param.label and editingAddress.label eq 'Xưởng')}">selected</c:if>>Xưởng</option><option value="Khác" <c:if test="${(not empty param.label and param.label eq 'Khác') or (empty param.label and editingAddress.label eq 'Khác')}">selected</c:if>>Khác</option></select></label>
                <label>Địa chỉ cụ thể<input name="addressLine" required maxlength="255" placeholder="Số nhà, tên đường..." value="<c:out value='${not empty param.addressLine ? param.addressLine : editingAddress.address_line}'/>"></label>
                <div class="account-modal-field vn-address-field"><label for="addressModalProvince">Tỉnh / thành phố</label><select id="addressModalProvince" data-province-select required><option value="">Đang tải tỉnh/thành…</option></select><input type="hidden" name="province" data-province-value value="<c:out value='${not empty param.province ? param.province : editingAddress.province}'/>"><input type="hidden" name="provinceCode" data-province-code value="<c:out value='${not empty param.provinceCode ? param.provinceCode : editingAddress.province_code}'/>"><input type="text" data-province-fallback class="vn-address-fallback" placeholder="Nhập tỉnh/thành phố" value="<c:out value='${not empty editingAddress ? editingAddress.province : param.province}'/>" hidden disabled></div>
                <div class="account-modal-field vn-address-field"><label for="addressModalWard">Phường / xã</label><select id="addressModalWard" data-ward-select required disabled><option value="">Chọn tỉnh/thành phố trước</option></select><input type="hidden" name="ward" data-ward-value value="<c:out value='${not empty param.ward ? param.ward : editingAddress.ward}'/>"><input type="hidden" name="wardCode" data-ward-code value="<c:out value='${not empty param.wardCode ? param.wardCode : editingAddress.ward_code}'/>"><input type="text" data-ward-fallback class="vn-address-fallback" placeholder="Nhập phường/xã" value="<c:out value='${not empty editingAddress ? editingAddress.ward : param.ward}'/>" hidden disabled></div>
                <input type="hidden" name="district" data-district-value value="<c:out value='${not empty param.district ? param.district : editingAddress.district}'/>">
                <p class="vn-address-api-status" data-address-api-status role="status">Đang tải danh mục địa giới hành chính…</p>
                <p class="vn-address-attribution">Nguồn dữ liệu: <a href="https://diachiviet.com/api-tinh-thanh/" target="_blank" rel="noopener noreferrer">Địa Chỉ Việt</a> · CC BY 4.0</p>
                <label class="span-full">Ghi chú giao hàng<textarea name="deliveryNote" rows="3" maxlength="500" placeholder="Ví dụ: giao trong giờ hành chính..."><c:out value="${not empty param.deliveryNote ? param.deliveryNote : editingAddress.delivery_note}"/></textarea></label>
                <label class="account-modal-check span-full"><input type="checkbox" name="isDefault" value="1" <c:if test="${param.action eq 'save' ? (param.isDefault eq '1') : editingAddress.is_default}">checked</c:if>> Đặt làm địa chỉ mặc định</label>
            </form>
        </div>
        <div class="account-modal-footer"><button type="button" class="account-modal-help-toggle" data-help-toggle aria-controls="addressModalHelp" aria-expanded="true">Ẩn hướng dẫn</button><div class="account-modal-footer-main"><button type="button" class="account-modal-button is-light" data-modal-close>Hủy</button><button type="submit" form="addressEditorForm" class="account-modal-button is-primary">Lưu địa chỉ</button></div></div>
    </div>
</dialog>
<dialog id="addressDeleteModal" class="account-modal" data-account-modal aria-labelledby="addressDeleteHeading">
    <div class="account-modal-panel">
        <div class="account-modal-header"><div class="account-modal-heading"><span class="account-modal-icon" aria-hidden="true">!</span><div><h2 id="addressDeleteHeading">Xóa địa chỉ?</h2><p>Thao tác này sẽ xóa địa chỉ khỏi sổ địa chỉ của bạn.</p></div></div><button type="button" class="account-modal-close" data-modal-close aria-label="Đóng">×</button></div>
        <div class="account-modal-scroll"><aside class="account-modal-help" id="addressDeleteHelp" data-modal-help><div class="account-modal-help-title">Trước khi xóa</div><ul><li>Hãy kiểm tra đúng địa chỉ trước khi xác nhận.</li><li>Nếu đây là địa chỉ mặc định, hệ thống sẽ chọn địa chỉ khác nếu còn địa chỉ đang lưu.</li><li>Đơn hàng đã tạo không bị thay đổi.</li></ul></aside><p class="account-modal-confirm-copy" data-address-delete-label></p></div>
        <div class="account-modal-footer"><button type="button" class="account-modal-help-toggle" data-help-toggle aria-controls="addressDeleteHelp" aria-expanded="true">Ẩn hướng dẫn</button><div class="account-modal-footer-main"><button type="button" class="account-modal-button is-light" data-modal-close>Hủy</button><form method="post" action="${pageContext.request.contextPath}/addresses" data-address-delete-form><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="addressId"><button type="submit" class="account-modal-button is-danger">Xác nhận xóa</button></form></div></div>
    </div>
</dialog>
<dialog id="addressDefaultModal" class="account-modal" data-account-modal aria-labelledby="addressDefaultHeading">
    <div class="account-modal-panel">
        <div class="account-modal-header"><div class="account-modal-heading"><span class="account-modal-icon" aria-hidden="true">✓</span><div><h2 id="addressDefaultHeading">Đặt địa chỉ mặc định?</h2><p>Địa chỉ này sẽ được ưu tiên chọn trong quá trình đặt hàng.</p></div></div><button type="button" class="account-modal-close" data-modal-close aria-label="Đóng">×</button></div>
        <div class="account-modal-scroll"><aside class="account-modal-help" id="addressDefaultHelp" data-modal-help><div class="account-modal-help-title">Cách dùng</div><ul><li>Bạn chỉ có một địa chỉ mặc định tại một thời điểm.</li><li>Đặt mặc định không xóa các địa chỉ khác; bạn vẫn có thể chọn địa chỉ khác khi checkout.</li></ul></aside><p class="account-modal-confirm-copy" data-address-default-label></p></div>
        <div class="account-modal-footer"><button type="button" class="account-modal-help-toggle" data-help-toggle aria-controls="addressDefaultHelp" aria-expanded="true">Ẩn hướng dẫn</button><div class="account-modal-footer-main"><button type="button" class="account-modal-button is-light" data-modal-close>Hủy</button><form method="post" action="${pageContext.request.contextPath}/addresses" data-address-default-form><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="default"><input type="hidden" name="addressId"><button type="submit" class="account-modal-button is-primary">Xác nhận</button></form></div></div>
    </div>
</dialog>

</main><script defer src="${pageContext.request.contextPath}/js/address-picker.js?v=20261125-address"></script><script defer src="${pageContext.request.contextPath}/js/account-modals.js?v=20261125-modals"></script><jsp:include page="/customer/footer.jsp"/></body></html>