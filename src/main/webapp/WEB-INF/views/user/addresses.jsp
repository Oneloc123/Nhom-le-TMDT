<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sổ địa chỉ | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Sổ địa chỉ</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">GIAO HÀNG NHANH HƠN</p><h1>Sổ địa chỉ</h1><p>Lưu nhiều địa chỉ và chọn địa chỉ mặc định cho lần đặt hàng tiếp theo.</p></div></div>
<c:if test="${param.updated eq '1'}"><div class="uv2-alert is-success">Sổ địa chỉ đã được cập nhật.</div></c:if><c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-address-layout"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">ĐỊA CHỈ ĐÃ LƯU</p><h2><c:out value="${fn:length(addresses)}"/> địa chỉ</h2></div></div>
<c:choose><c:when test="${empty addresses}"><div class="uv2-empty"><b>Chưa có địa chỉ nào</b><p>Thêm địa chỉ giao hàng đầu tiên của bạn.</p></div></c:when><c:otherwise><div class="uv2-address-list"><c:forEach var="a" items="${addresses}"><article class="uv2-address-card"><div class="uv2-address-card-head"><div><span class="uv2-address-label"><c:out value="${a.label}"/></span><c:if test="${a.is_default}"><span class="uv2-default-pill">Mặc định</span></c:if></div><b><c:out value="${a.recipient_name}"/></b></div><p><c:out value="${a.recipient_phone}"/></p><p><c:out value="${a.address_line}"/>, <c:out value="${a.ward}"/>, <c:out value="${a.district}"/>, <c:out value="${a.province}"/></p><c:if test="${not empty a.delivery_note}"><small>Ghi chú: <c:out value="${a.delivery_note}"/></small></c:if><div class="uv2-address-actions"><a href="${pageContext.request.contextPath}/addresses?edit=${a.address_id}#address-form">Sửa</a><c:if test="${!a.is_default}"><form method="post" action="${pageContext.request.contextPath}/addresses"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="default"><input type="hidden" name="addressId" value="${a.address_id}"><button>Đặt mặc định</button></form></c:if><form method="post" action="${pageContext.request.contextPath}/addresses" onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?')"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="delete"><input type="hidden" name="addressId" value="${a.address_id}"><button class="is-danger">Xóa</button></form></div></article></c:forEach></div></c:otherwise></c:choose></section>
<section class="uv2-panel" id="address-form"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">THÔNG TIN GIAO NHẬN</p><h2><c:choose><c:when test="${not empty editingAddress}">Chỉnh sửa địa chỉ</c:when><c:otherwise>Thêm địa chỉ mới</c:otherwise></c:choose></h2></div></div>
<form method="post" action="${pageContext.request.contextPath}/addresses" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="addressId" value="<c:out value='${editingAddress.address_id}'/>"><label>Người nhận<input name="recipientName" required maxlength="120" value="<c:out value='${editingAddress.recipient_name}'/>" autocomplete="name"></label><label>Số điện thoại<input name="recipientPhone" required maxlength="25" value="<c:out value='${editingAddress.recipient_phone}'/>" autocomplete="tel"></label><label>Loại địa chỉ<select name="label"><option value="Nhà riêng">Nhà riêng</option><option value="Văn phòng" <c:if test="${editingAddress.label eq 'Văn phòng'}">selected</c:if>>Văn phòng</option><option value="Xưởng" <c:if test="${editingAddress.label eq 'Xưởng'}">selected</c:if>>Xưởng</option><option value="Khác" <c:if test="${editingAddress.label eq 'Khác'}">selected</c:if>>Khác</option></select></label><label>Tỉnh / thành phố<input name="province" required maxlength="100" value="<c:out value='${editingAddress.province}'/>"></label><label>Quận / huyện<input name="district" required maxlength="100" value="<c:out value='${editingAddress.district}'/>"></label><label>Phường / xã<input name="ward" maxlength="100" value="<c:out value='${editingAddress.ward}'/>"></label><label>Địa chỉ cụ thể<input name="addressLine" required maxlength="255" value="<c:out value='${editingAddress.address_line}'/>" placeholder="Số nhà, tên đường..."></label><label>Ghi chú giao hàng<textarea name="deliveryNote" rows="3" maxlength="500"><c:out value="${editingAddress.delivery_note}"/></textarea></label><label class="uv2-check"><input type="checkbox" name="isDefault" value="1" <c:if test="${editingAddress.is_default}">checked</c:if>> Đặt làm địa chỉ mặc định</label><button class="uv2-button is-primary">Lưu địa chỉ</button><c:if test="${not empty editingAddress}"><a class="uv2-cancel-link" href="${pageContext.request.contextPath}/addresses">Hủy chỉnh sửa</a></c:if></form></section></div></main><jsp:include page="/customer/footer.jsp"/></body></html>
