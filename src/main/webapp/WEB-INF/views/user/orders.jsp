<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn hàng của tôi | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Đơn hàng</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">LỊCH SỬ MUA SẮM</p><h1>Đơn hàng của tôi</h1><p>Theo dõi tiến độ xử lý, thanh toán và giao hàng.</p></div><span class="uv2-result-count"><c:out value="${totalOrders}"/> đơn hàng</span></div>
<section class="uv2-panel"><form method="get" action="${pageContext.request.contextPath}/purchase-history" class="uv2-filter"><label for="statusFilter">Trạng thái đơn hàng</label><select id="statusFilter" name="status"><option value="ALL" <c:if test="${status eq 'ALL'}">selected</c:if>>Tất cả</option><option value="Chờ thanh toán" <c:if test="${status eq 'Chờ thanh toán'}">selected</c:if>>Chờ thanh toán</option><option value="Đã xác nhận" <c:if test="${status eq 'Đã xác nhận'}">selected</c:if>>Đã xác nhận</option><option value="Đang xử lý" <c:if test="${status eq 'Đang xử lý'}">selected</c:if>>Đang xử lý</option><option value="Đang giao hàng" <c:if test="${status eq 'Đang giao hàng'}">selected</c:if>>Đang giao hàng</option><option value="Đã hoàn thành" <c:if test="${status eq 'Đã hoàn thành'}">selected</c:if>>Đã hoàn thành</option><option value="Đã hủy" <c:if test="${status eq 'Đã hủy'}">selected</c:if>>Đã hủy</option></select><button class="uv2-button is-primary">Lọc đơn hàng</button></form>
<c:choose><c:when test="${empty orders}"><div class="uv2-empty"><b>Không tìm thấy đơn hàng</b><p>Thử chọn trạng thái khác hoặc khám phá sản phẩm mới.</p><a class="uv2-button is-light" href="${pageContext.request.contextPath}/purchase-history">Xóa bộ lọc</a></div></c:when><c:otherwise><div class="uv2-order-list"><c:forEach var="o" items="${orders}"><article class="uv2-order-card"><div class="uv2-order-top"><div><small>MÃ ĐƠN HÀNG</small><b><c:out value="${o.orderCode}"/></b></div><span class="uv2-status"><c:out value="${o.status}"/></span></div><div class="uv2-order-meta"><span>Ngày đặt: <b><c:out value="${o.placedAt}"/></b></span><span><c:out value="${o.itemCount}"/> sản phẩm</span><span>Thanh toán: <b><c:out value="${o.paymentStatus}"/></b></span></div><div class="uv2-order-bottom"><div><small>TỔNG THANH TOÁN</small><strong><c:out value="${o.totalAmount}"/> ₫</strong></div><a class="uv2-button is-light" href="${pageContext.request.contextPath}/order-detail?code=${o.orderCode}">Xem chi tiết →</a></div></article></c:forEach></div>
<c:if test="${totalPages gt 1}"><nav class="uv2-pagination" aria-label="Phân trang"><c:if test="${currentPage gt 1}"><a href="${pageContext.request.contextPath}/purchase-history?status=${status}&page=${currentPage-1}">← Trước</a></c:if><span>Trang <c:out value="${currentPage}"/> / <c:out value="${totalPages}"/></span><c:if test="${currentPage lt totalPages}"><a href="${pageContext.request.contextPath}/purchase-history?status=${status}&page=${currentPage+1}">Tiếp →</a></c:if></nav></c:if></c:otherwise></c:choose></section></main><jsp:include page="/customer/footer.jsp"/></body></html>
