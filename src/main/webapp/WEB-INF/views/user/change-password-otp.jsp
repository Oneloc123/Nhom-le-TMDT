<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172b49"><title>Xác minh đổi mật khẩu | PrintKraft</title>
<style>
:root{--ink:#18263c;--muted:#6b7a90;--blue:#2864e8;--line:#dce5f1;--red:#a62736}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:24px;display:grid;place-items:center;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 9% 15%,rgba(50,108,239,.13),transparent 27%),radial-gradient(circle at 90% 85%,rgba(247,190,90,.17),transparent 25%),#f3f6fb}.card{width:min(100%,520px);padding:clamp(27px,6vw,47px);background:#fff;border:1px solid #e2e9f2;border-radius:25px;box-shadow:0 24px 66px rgba(26,48,82,.13)}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:19px;font-weight:850;letter-spacing:-.5px}.logo{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;color:#fff;background:linear-gradient(140deg,#3478ff,#214fc2);box-shadow:0 7px 16px rgba(38,100,232,.25)}.icon-box{margin-top:29px;width:62px;height:62px;border-radius:20px;display:grid;place-items:center;color:#2457bf;background:#edf3ff}.icon-box svg{width:28px;height:28px}.eyebrow{margin:27px 0 9px;color:var(--blue);font-size:11px;font-weight:850;letter-spacing:1.8px}.card h1{margin:0;font-size:29px;letter-spacing:-.8px}.lead{margin:12px 0 23px;color:var(--muted);font-size:13px;line-height:1.75;overflow-wrap:anywhere}.lead strong{color:#314664}.alert{padding:12px 14px;border:1px solid;border-radius:12px;margin:0 0 15px;font-size:13px;line-height:1.55}.error{color:var(--red);border-color:#fecdd3;background:#fff1f2}.success{color:#166534;border-color:#bbf7d0;background:#f0fdf4}.field{display:flex;flex-direction:column;gap:8px}.field label{font-size:12px;font-weight:800;color:#34445c}.otp{width:100%;height:60px;border:1px solid var(--line);border-radius:13px;padding:0 15px 0 24px;background:#fafcff;color:var(--ink);font-size:27px;font-weight:800;letter-spacing:12px;text-align:center;outline:none;transition:.18s}.otp:focus{border-color:#4d7ff0;box-shadow:0 0 0 4px rgba(40,100,232,.12);background:#fff}.button{width:100%;height:51px;margin-top:18px;border:0;border-radius:12px;color:#fff;background:linear-gradient(135deg,#2f70f6,#2153cc);font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 9px 18px rgba(38,100,232,.2)}.button:hover{filter:brightness(1.04)}.secondary{margin-top:14px;text-align:center}.secondary button{padding:8px 10px;border:0;background:transparent;color:#2457bf;font-weight:800;font-size:13px;cursor:pointer}.hint{display:flex;gap:10px;margin-top:19px;padding:12px 13px;border:1px solid #e5edf9;border-radius:12px;background:#f8faff;color:#718099;font-size:11px;line-height:1.65}.hint span{font-size:17px}.bottom{margin:22px 0 0;padding-top:18px;border-top:1px solid #edf1f7;text-align:center;color:#8491a4;font-size:12px}.bottom a{color:#526782;text-decoration:none;font-weight:750}.bottom a:hover{text-decoration:underline}@media(max-width:480px){body{padding:14px}.card{padding:27px 22px;border-radius:20px}.card h1{font-size:26px}}
</style></head><body><main class="card"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="logo">P</span>PrintKraft <span style="color:#2864e8">3D</span></a><div class="icon-box" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="m9.5 15 1.6 1.6 3.6-3.7"/></svg></div><p class="eyebrow">XÁC MINH BẢO MẬT</p><h1>Xác nhận đổi mật khẩu</h1><p class="lead">Nhập mã OTP vừa gửi tới email <strong><c:out value="${email}"/></strong>. Mã sẽ hết hạn sau 5 phút.</p><c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert success" role="status"><c:out value="${success}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/change-password/otp/confirm"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="field"><label for="otp">Mã OTP 6 chữ số</label><input class="otp" id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autocomplete="one-time-code" placeholder="••••••"></div><button class="button" type="submit">Xác nhận và lưu mật khẩu&nbsp; →</button></form><form class="secondary" method="post" action="${pageContext.request.contextPath}/change-password/otp/confirm"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="resend"><button type="submit">Chưa nhận được mã? Gửi lại</button></form><div class="hint"><span>🔐</span><div>Vì sự an toàn của bạn, mật khẩu mới chỉ được lưu sau khi mã xác minh hợp lệ.</div></div><p class="bottom"><a href="${pageContext.request.contextPath}/change-password">← Quay lại đổi mật khẩu</a></p></main><jsp:include page="/customer/chatbot-widget.jsp"/>
</body></html>
