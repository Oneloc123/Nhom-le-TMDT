<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Yêu cầu in 3D của tôi | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Yêu cầu in 3D</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">CUSTOM PRINT ACTIVITY</p><h1>Yêu cầu in 3D của tôi</h1><p>Theo dõi file mô hình, vật liệu và trạng thái tiếp nhận từ xưởng.</p></div><a class="uv2-button is-primary" href="${pageContext.request.contextPath}/design">＋ Gửi yêu cầu mới</a></div>
<c:if test="${param.created eq '1'}"><div class="uv2-alert is-success">Yêu cầu <b><c:out value="${param.code}"/></b> đã được gửi thành công.</div></c:if>
<section class="uv2-panel"><c:choose><c:when test="${empty requests}"><div class="uv2-empty"><b>Bạn chưa gửi yêu cầu in 3D</b><p>Tải mô hình 3D của bạn lên để bắt đầu quy trình báo giá.</p><a class="uv2-button is-primary" href="${pageContext.request.contextPath}/design">Gửi mô hình đầu tiên</a></div></c:when><c:otherwise><div class="uv2-design-request-list"><c:forEach var="r" items="${requests}"><article class="uv2-design-request"><div class="uv2-design-file-icon">3D</div><div class="uv2-design-request-main"><div class="uv2-design-request-title"><b><c:out value="${r.request_code}"/></b><span class="uv2-status"><c:out value="${r.status}"/></span></div><p><c:out value="${r.original_filename}"/></p><div class="uv2-order-meta"><span>Vật liệu: <b><c:out value="${r.material}"/></b></span><span>Công nghệ: <b><c:out value="${r.technology}"/></b></span><span>Số lượng: <b><c:out value="${r.quantity}"/></b></span></div><small>Gửi lúc <c:out value="${r.created_at}"/></small></div><div class="uv2-design-request-price"><c:choose><c:when test="${not empty r.quoted_amount}"><small>Báo giá</small><b><c:out value="${r.quoted_amount}"/> ₫</b></c:when><c:otherwise><small>Đang chờ kiểm tra</small><b>—</b></c:otherwise></c:choose></div><a class="uv2-button is-light" href="${pageContext.request.contextPath}/my-designs/file?id=${r.design_file_id}">Tải file</a></article></c:forEach></div></c:otherwise></c:choose></section></main><jsp:include page="/customer/footer.jsp"/></body></html>
