<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172b49"><title>Xác thực tài khoản | PrintKraft</title>
<style>
:root{--ink:#18263c;--muted:#6b7a90;--blue:#2864e8;--line:#dce5f1;--red:#a62736}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:24px;display:grid;place-items:center;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 9% 15%,rgba(50,108,239,.13),transparent 27%),radial-gradient(circle at 90% 85%,rgba(247,190,90,.17),transparent 25%),#f3f6fb}.card{width:min(100%,500px);padding:clamp(27px,6vw,48px);background:#fff;border:1px solid #e2e9f2;border-radius:25px;box-shadow:0 24px 66px rgba(26,48,82,.13)}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:19px;font-weight:850;letter-spacing:-.5px}.logo{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;color:#fff;background:linear-gradient(140deg,#3478ff,#214fc2);box-shadow:0 7px 16px rgba(38,100,232,.25)}.eyebrow{margin:31px 0 9px;color:var(--blue);font-size:11px;font-weight:850;letter-spacing:1.8px}.icon-box{margin-top:28px;width:62px;height:62px;border-radius:20px;display:grid;place-items:center;color:#2457bf;background:#edf3ff}.icon-box svg{width:28px;height:28px}.card h1{margin:0;font-size:30px;letter-spacing:-.8px}.lead{margin:12px 0 25px;color:var(--muted);font-size:14px;line-height:1.75;overflow-wrap:anywhere}.lead strong{color:#314664}.alert{padding:12px 14px;border:1px solid;border-radius:12px;margin:0 0 17px;font-size:13px;line-height:1.55}.error{color:var(--red);border-color:#fecdd3;background:#fff1f2}.success{color:#166534;border-color:#bbf7d0;background:#f0fdf4}.label{display:block;margin-bottom:9px;font-size:12px;font-weight:800;color:#34445c}.otp{display:block;width:100%;height:62px;border:1px solid var(--line);border-radius:13px;background:#fafcff;text-align:center;color:var(--ink);font-size:27px;font-weight:800;letter-spacing:12px;padding-left:18px;outline:none;transition:.18s}.otp:focus{border-color:#4d7ff0;box-shadow:0 0 0 4px rgba(40,100,232,.12);background:#fff}.button{width:100%;height:51px;margin-top:18px;border:0;border-radius:12px;color:#fff;background:linear-gradient(135deg,#2f70f6,#2153cc);font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 9px 18px rgba(38,100,232,.2)}.button:hover{filter:brightness(1.04)}.secondary{margin-top:15px;text-align:center}.secondary button{padding:8px 10px;border:0;background:transparent;color:#2457bf;font-weight:800;font-size:13px;cursor:pointer}.bottom{margin:23px 0 0;padding-top:19px;border-top:1px solid #edf1f7;text-align:center;color:#8491a4;font-size:12px}.bottom a{color:#526782;text-decoration:none;font-weight:750}.bottom a:hover{text-decoration:underline}@media(max-width:480px){body{padding:14px}.card{border-radius:20px;padding:27px 22px}.card h1{font-size:27px}}
</style></head><body><main class="card"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="logo">P</span>PrintKraft <span style="color:#2864e8">3D</span></a><div class="icon-box" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="m5 7 7 5.5L19 7"/><circle cx="18.5" cy="17.5" r="4" fill="#edf3ff"/><path d="m16.7 17.4 1.2 1.2 2.1-2.4"/></svg></div><p class="eyebrow">XÁC MINH EMAIL</p><h1>Nhập mã OTP</h1><p class="lead">Mã xác minh gồm 6 chữ số dành cho <strong><c:out value="${email}"/></strong>. Mã có hiệu lực trong 15 phút.</p>
<c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty success}"><div class="alert success" role="status"><c:out value="${success}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/register/otp"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><label class="label" for="code">Mã xác minh</label><input class="otp" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autocomplete="one-time-code" placeholder="••••••" aria-label="Mã OTP 6 chữ số"><button class="button" type="submit">Xác nhận tài khoản&nbsp; →</button></form>
<form class="secondary" method="post" action="${pageContext.request.contextPath}/register/otp"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="resend"><button type="submit">Chưa nhận được mã? Gửi lại</button></form><p class="bottom"><a href="${pageContext.request.contextPath}/register">← Quay lại đăng ký</a></p></main></body></html>
