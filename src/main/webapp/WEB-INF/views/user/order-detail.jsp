<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết đơn hàng | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><a href="${pageContext.request.contextPath}/purchase-history">Đơn hàng</a><span>/</span><span>Chi tiết</span></div>
<div class="uv2-page-heading"><div><p class="uv2-eyebrow">CHI TIẾT ĐƠN HÀNG</p><h1><c:out value="${order.orderCode}"/></h1><p>Đặt lúc <c:out value="${order.placedAt}"/></p></div><span class="uv2-status"><c:out value="${order.status}"/></span></div>
<c:if test="${param.cancelled eq '1'}"><div class="uv2-alert is-success">Đơn hàng đã được hủy.</div></c:if><c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-detail-grid"><div class="uv2-content"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">SẢN PHẨM</p><h2>Các mặt hàng trong đơn</h2></div></div><div class="uv2-table-wrap"><table class="uv2-table"><thead><tr><th>Sản phẩm</th><th>Xưởng</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td><b><c:out value="${item.productName}"/></b><small class="uv2-cell-sub"><c:out value="${item.status}"/></small></td><td><c:out value="${item.shopName}"/></td><td><c:out value="${item.quantity}"/></td><td><c:out value="${item.unitPrice}"/> ₫</td><td><b><c:out value="${item.lineTotal}"/> ₫</b></td></tr></c:forEach></tbody></table></div></section>
<section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">TIẾN ĐỘ</p><h2>Lịch sử trạng thái</h2></div></div><div class="uv2-timeline"><c:forEach var="event" items="${order.timeline}"><article><span class="uv2-timeline-dot"></span><div><b><c:out value="${event.newStatus}"/></b><small><c:out value="${event.changedAt}"/></small><p><c:out value="${event.note}"/></p></div></article></c:forEach><c:if test="${empty order.timeline}"><p class="uv2-muted">Chưa có cập nhật trạng thái.</p></c:if></div></section></div>
<aside class="uv2-content"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">TÓM TẮT</p><h2>Thanh toán</h2></div></div><div class="uv2-total-row"><span>Tạm tính</span><b><c:out value="${order.subtotal}"/> ₫</b></div><div class="uv2-total-row"><span>Phí vận chuyển</span><b><c:out value="${order.shippingFee}"/> ₫</b></div><div class="uv2-total-row is-grand"><span>Tổng cộng</span><b><c:out value="${order.totalAmount}"/> ₫</b></div><p class="uv2-muted">Trạng thái thanh toán: <b><c:out value="${order.paymentStatus}"/></b></p></section>
<section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">GIAO HÀNG</p><h2>Người nhận</h2></div></div><b><c:out value="${order.recipientName}"/></b><p><c:out value="${order.recipientPhone}"/></p><p><c:out value="${order.shippingAddress}"/></p><c:if test="${not empty order.customerNote}"><small>Ghi chú: <c:out value="${order.customerNote}"/></small></c:if></section>
<c:if test="${order.canCancel}"><section class="uv2-panel uv2-cancel-panel"><h3>Hủy đơn hàng</h3><p>Chỉ có thể hủy đơn trước khi xưởng bắt đầu xử lý.</p><form method="post" action="${pageContext.request.contextPath}/order-detail" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="cancel"><input type="hidden" name="code" value="<c:out value='${order.orderCode}'/>"><label>Lý do hủy (không bắt buộc)<textarea name="reason" rows="3" maxlength="500"></textarea></label><button class="uv2-button is-danger" onclick="return confirm('Bạn xác nhận muốn hủy đơn hàng này?')">Hủy đơn hàng</button></form></section></c:if>
</aside></div><a class="uv2-back-link" href="${pageContext.request.contextPath}/purchase-history">← Quay lại danh sách đơn hàng</a></main><jsp:include page="/customer/footer.jsp"/></body></html>
