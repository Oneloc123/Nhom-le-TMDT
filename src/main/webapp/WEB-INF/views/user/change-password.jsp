<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172b49"><title>Đổi mật khẩu | PrintKraft</title>
<style>
:root{--ink:#18263c;--muted:#6b7a90;--blue:#2864e8;--line:#dce5f1;--red:#a62736}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:24px;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 8% 10%,rgba(50,108,239,.12),transparent 27%),radial-gradient(circle at 94% 90%,rgba(247,190,90,.15),transparent 25%),#f3f6fb}.page{width:min(100%,1000px);margin:0 auto}.nav{display:flex;align-items:center;justify-content:space-between;gap:18px;margin:7px 0 25px}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:18px;font-weight:850;letter-spacing:-.5px}.logo{width:36px;height:36px;display:grid;place-items:center;border-radius:11px;color:#fff;background:linear-gradient(140deg,#3478ff,#214fc2)}.nav-links{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:#64748b}.nav-links a{text-decoration:none;font-weight:750}.nav-links a:hover{color:var(--blue)}.layout{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr);border:1px solid #e2e9f2;border-radius:26px;overflow:hidden;background:#fff;box-shadow:0 24px 66px rgba(26,48,82,.12)}.intro{position:relative;isolation:isolate;overflow:hidden;padding:39px 32px;color:#fff;background:linear-gradient(145deg,#14243b,#214b87)}.intro:after{content:"";position:absolute;z-index:-1;right:-90px;bottom:-92px;width:270px;height:270px;border:1px solid rgba(255,255,255,.16);border-radius:50%;box-shadow:0 0 0 22px rgba(255,255,255,.025),0 0 0 50px rgba(255,255,255,.025)}.intro-icon{display:grid;place-items:center;width:64px;height:64px;border-radius:20px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.17);color:#ffe0a1}.intro-icon svg{width:31px;height:31px}.eyebrow{margin:31px 0 10px;color:#aec7ff;font-size:11px;font-weight:850;letter-spacing:1.7px}.intro h1{margin:0;font-size:32px;line-height:1.15;letter-spacing:-1px}.intro p{color:#cfdbef;font-size:13px;line-height:1.8}.tips{margin-top:32px;padding-top:20px;border-top:1px solid rgba(255,255,255,.15);color:#dbe6f6;font-size:12px;line-height:1.75}.form-side{padding:38px clamp(23px,5vw,55px)}.crumb{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 22px;color:#8996a9;font-size:11px}.crumb a{color:#5d6e86;text-decoration:none;font-weight:700}.crumb a:hover{color:var(--blue)}.form-head h2{margin:0;font-size:27px;letter-spacing:-.8px}.form-head p{margin:10px 0 23px;color:var(--muted);font-size:13px;line-height:1.7}.alert{padding:12px 14px;border:1px solid;border-radius:12px;margin:0 0 17px;font-size:13px;line-height:1.55}.error{color:var(--red);border-color:#fecdd3;background:#fff1f2}.fields{display:grid;gap:15px}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:12px;font-weight:800;color:#34445c}.field input{width:100%;height:49px;border:1px solid var(--line);border-radius:12px;padding:0 14px;background:#fafcff;color:var(--ink);font:inherit;font-size:14px;outline:none;transition:.18s}.field input:focus{border-color:#4d7ff0;box-shadow:0 0 0 4px rgba(40,100,232,.12);background:#fff}.field input::placeholder{color:#a1adbd}.note{display:flex;gap:10px;margin-top:18px;padding:12px 13px;border:1px solid #e5edf9;border-radius:12px;background:#f8faff;color:#718099;font-size:11px;line-height:1.65}.note span{font-size:17px}.button{width:100%;height:51px;margin-top:20px;border:0;border-radius:12px;color:#fff;background:linear-gradient(135deg,#2f70f6,#2153cc);font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 9px 18px rgba(38,100,232,.2)}.button:hover{filter:brightness(1.04)}.footer-link{display:block;margin-top:20px;text-align:center;color:#60718a;font-size:12px;font-weight:750;text-decoration:none}.footer-link:hover{color:var(--blue)}@media(max-width:760px){body{padding:15px}.layout{grid-template-columns:1fr}.intro{padding:26px 25px}.intro-icon{width:52px;height:52px;border-radius:16px}.eyebrow{margin-top:19px}.intro h1{font-size:27px}.intro p{margin-bottom:0}.tips{margin-top:16px;padding-top:12px}.form-side{padding:26px 23px}.nav{margin:3px 2px 18px}.nav-links{gap:12px}}@media(max-width:430px){.nav{align-items:flex-start;flex-direction:column}.form-head h2{font-size:25px}}
</style></head><body><main class="page"><header class="nav"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="logo">P</span>PrintKraft <span style="color:#2864e8">3D</span></a><nav class="nav-links"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><a href="${pageContext.request.contextPath}/profile">Thông tin cá nhân</a></nav></header><div class="layout"><aside class="intro"><div class="intro-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.2"/><path d="M12 16.7v1.3"/></svg></div><p class="eyebrow">BẢO MẬT TÀI KHOẢN</p><h1>Giữ tài khoản<br>luôn an toàn.</h1><p>Đổi mật khẩu định kỳ giúp bảo vệ thông tin cá nhân và lịch sử đơn hàng của bạn.</p><div class="tips"><strong>Quy tắc mật khẩu tốt</strong><br>Dùng ít nhất 8 ký tự và tránh sử dụng lại mật khẩu từ những dịch vụ khác.</div></aside><section class="form-side"><div class="crumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>›</span><a href="${pageContext.request.contextPath}/profile">Thông tin cá nhân</a><span>›</span><span>Đổi mật khẩu</span></div><div class="form-head"><h2>Đặt mật khẩu mới</h2><p>Nhập mật khẩu hiện tại và mật khẩu mới. Bạn sẽ xác minh OTP email trước khi thay đổi được lưu.</p></div><c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/change-password"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="fields"><c:if test="${hasPassword}"><div class="field"><label for="currentPassword">Mật khẩu hiện tại</label><input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required maxlength="72" placeholder="Nhập mật khẩu hiện tại"></div></c:if><c:if test="${not hasPassword}"><div class="note"><span>ℹ</span><div>Tài khoản Google/Facebook chưa có mật khẩu riêng. Bạn có thể đặt mật khẩu mới sau khi xác minh email.</div></div></c:if><div class="field"><label for="newPassword">Mật khẩu mới</label><input id="newPassword" type="password" name="newPassword" autocomplete="new-password" required minlength="8" maxlength="72" placeholder="Ít nhất 8 ký tự"></div><div class="field"><label for="confirmPassword">Nhập lại mật khẩu mới</label><input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" required minlength="8" maxlength="72" placeholder="Nhập lại mật khẩu mới"></div></div><button class="button" type="submit">Gửi mã OTP&nbsp; →</button></form><div class="note"><span>✉</span><div>Mã xác minh được gửi tới email của tài khoản và có hiệu lực trong 5 phút. Khi SMTP chưa cấu hình, bạn có thể dùng OTP demo <strong>111111</strong>.</div></div><a class="footer-link" href="${pageContext.request.contextPath}/profile">← Quay lại thông tin cá nhân</a></section></div></main></body></html>
