<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172b49"><title>Xác minh khôi phục mật khẩu | PrintKraft</title>
<style>
:root{--ink:#18263c;--muted:#6b7a90;--blue:#2864e8;--line:#dce5f1;--red:#a62736}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:22px;display:grid;place-items:center;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 9% 15%,rgba(50,108,239,.13),transparent 27%),radial-gradient(circle at 90% 85%,rgba(247,190,90,.17),transparent 25%),#f3f6fb}.card{width:min(100%,540px);padding:clamp(26px,5vw,44px);background:#fff;border:1px solid #e2e9f2;border-radius:25px;box-shadow:0 24px 66px rgba(26,48,82,.13)}.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:19px;font-weight:850;letter-spacing:-.5px}.logo{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;color:#fff;background:linear-gradient(140deg,#3478ff,#214fc2);box-shadow:0 7px 16px rgba(38,100,232,.25)}.eyebrow{margin:28px 0 9px;color:var(--blue);font-size:11px;font-weight:850;letter-spacing:1.8px}.card h1{margin:0;font-size:29px;letter-spacing:-.8px}.lead{margin:12px 0 23px;color:var(--muted);font-size:13px;line-height:1.7;overflow-wrap:anywhere}.lead strong{color:#314664}.alert{padding:12px 14px;border:1px solid;border-radius:12px;margin:0 0 15px;font-size:13px;line-height:1.55}.error{color:var(--red);border-color:#fecdd3;background:#fff1f2}.success{color:#166534;border-color:#bbf7d0;background:#f0fdf4}.fields{display:grid;gap:14px}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:12px;font-weight:800;color:#34445c}.field input{width:100%;height:48px;border:1px solid var(--line);border-radius:12px;padding:0 14px;background:#fafcff;color:var(--ink);font:inherit;font-size:14px;outline:none;transition:.18s}.field input:focus{border-color:#4d7ff0;box-shadow:0 0 0 4px rgba(40,100,232,.12);background:#fff}.otp-input{height:53px!important;text-align:center;font-size:21px!important;font-weight:800;letter-spacing:9px;padding-left:20px!important}.button{width:100%;height:51px;margin-top:20px;border:0;border-radius:12px;color:#fff;background:linear-gradient(135deg,#2f70f6,#2153cc);font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 9px 18px rgba(38,100,232,.2)}.button:hover{filter:brightness(1.04)}.secondary{margin-top:13px;text-align:center}.secondary button{padding:8px 10px;border:0;background:transparent;color:#2457bf;font-weight:800;font-size:13px;cursor:pointer}.bottom{margin:21px 0 0;padding-top:17px;border-top:1px solid #edf1f7;text-align:center;color:#8491a4;font-size:12px}.bottom a{color:#526782;text-decoration:none;font-weight:750}.bottom a:hover{text-decoration:underline}@media(max-width:480px){body{padding:13px}.card{padding:25px 20px;border-radius:20px}.card h1{font-size:26px}}
</style></head><body><main class="card"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="logo">P</span>PrintKraft <span style="color:#2864e8">3D</span></a><p class="eyebrow">BƯỚC 2 · XÁC MINH BẢO MẬT</p><h1>Tạo mật khẩu mới</h1><p class="lead">Nhập mã OTP đã gửi đến <strong><c:out value="${email}"/></strong>, sau đó đặt mật khẩu mới. Mã có hiệu lực trong 15 phút.</p>
<c:if test="${not empty info}"><div class="alert success" role="status"><c:out value="${info}"/></div></c:if><c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/forgot-password/otp"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="fields"><div class="field"><label for="otp">Mã OTP 6 chữ số</label><input class="otp-input" id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required autocomplete="one-time-code" placeholder="••••••"></div><div class="field"><label for="password">Mật khẩu mới</label><input id="password" type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required placeholder="Ít nhất 8 ký tự"></div><div class="field"><label for="confirmPassword">Nhập lại mật khẩu</label><input id="confirmPassword" type="password" name="confirmPassword" minlength="8" maxlength="72" autocomplete="new-password" required placeholder="Nhập lại mật khẩu mới"></div></div><button class="button" type="submit">Xác nhận và đổi mật khẩu&nbsp; →</button></form>
<form class="secondary" method="post" action="${pageContext.request.contextPath}/forgot-password/otp"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="resend"><button type="submit">Chưa nhận được mã? Gửi lại</button></form><p class="bottom"><a href="${pageContext.request.contextPath}/forgot-password">← Thử email khác</a></p></main><jsp:include page="/customer/chatbot-widget.jsp"/>
</body></html>
