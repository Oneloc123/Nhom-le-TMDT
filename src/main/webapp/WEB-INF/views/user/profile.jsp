<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thông tin cá nhân | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css?v=20261104-account-layout"></head><body>
<jsp:include page="/customer/header.jsp"/><main class="uv2-page"><div class="uv2-breadcrumb"><a href="${pageContext.request.contextPath}/account">Tài khoản</a><span>/</span><span>Thông tin cá nhân</span></div><div class="uv2-page-heading"><div><p class="uv2-eyebrow">HỒ SƠ CỦA BẠN</p><h1>Thông tin cá nhân</h1><p>Cập nhật thông tin liên hệ và cài đặt bảo mật.</p></div></div>
<c:if test="${not empty success}"><div class="uv2-alert is-success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<div class="uv2-account-grid"><jsp:include page="/WEB-INF/views/user/account-sidebar.jsp"/>
<div class="uv2-content"><section class="uv2-panel"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">HỒ SƠ</p><h2>Thông tin cơ bản</h2></div></div><div class="uv2-profile-photo"><c:choose><c:when test="${not empty accountUser.avatarUrl}"><img src="${pageContext.request.contextPath}/account-avatar" alt="Ảnh đại diện"></c:when><c:otherwise><span><c:out value="${accountUser.userInitial}"/></span></c:otherwise></c:choose><div><b><c:out value="${accountUser.displayName}"/></b><small>Ảnh JPG/PNG, tối đa 3 MB</small></div><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/profile"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="avatar"><label class="uv2-button is-light uv2-file-button">Tải ảnh lên<input type="file" name="avatar" accept="image/jpeg,image/png" required></label><button class="uv2-button is-primary" type="submit">Lưu ảnh</button></form></div>
<form method="post" action="${pageContext.request.contextPath}/profile" class="uv2-form uv2-form-grid"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="profile"><label>Họ và tên<input name="fullName" maxlength="120" required value="<c:out value='${accountUser.fullName}'/>" autocomplete="name"></label><label>Email<input type="email" name="email" maxlength="190" required value="<c:out value='${accountUser.email}'/>" autocomplete="email"></label><label>Số điện thoại<input name="phone" maxlength="25" value="<c:out value='${accountUser.phone}'/>" autocomplete="tel"></label><label>Ngày sinh<input type="date" name="birthDate" value="<c:out value='${accountUser.birthDate}'/>"></label><label>Giới tính<select name="gender"><option value="" <c:if test="${empty accountUser.gender}">selected</c:if>>Chưa chọn</option><option value="Nam" <c:if test="${accountUser.gender eq 'Nam'}">selected</c:if>>Nam</option><option value="Nữ" <c:if test="${accountUser.gender eq 'Nữ'}">selected</c:if>>Nữ</option><option value="Khác" <c:if test="${accountUser.gender eq 'Khác'}">selected</c:if>>Khác</option></select></label><label class="uv2-check"><input type="checkbox" name="notifyEmail" value="1" <c:if test="${accountUser.notifyEmail}">checked</c:if>> Nhận thông báo qua email</label><div class="uv2-form-actions"><button class="uv2-button is-primary">Lưu thay đổi</button></div></form></section>
<section class="uv2-panel" id="security-settings"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">BẢO MẬT</p><h2>Đổi mật khẩu</h2><p>Nên sử dụng mật khẩu riêng, khó đoán và không dùng lại ở website khác.</p></div></div><form method="post" action="${pageContext.request.contextPath}/profile" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="password"><label>Mật khẩu hiện tại<input type="password" name="currentPassword" autocomplete="current-password" required maxlength="72"></label><label>Mật khẩu mới<input type="password" name="newPassword" autocomplete="new-password" required minlength="8" maxlength="72"></label><button class="uv2-button is-primary">Cập nhật mật khẩu</button></form><div class="uv2-login-history"><h3>Hoạt động đăng nhập gần đây</h3><c:choose><c:when test="${empty loginHistory}"><p class="uv2-muted">Chưa có lịch sử đăng nhập.</p></c:when><c:otherwise><div class="uv2-table-wrap"><table class="uv2-table"><thead><tr><th>Thời điểm</th><th>Kết quả</th><th>Phương thức</th><th>IP</th></tr></thead><tbody><c:forEach var="entry" items="${loginHistory}"><tr><td><c:out value="${entry.createdAt}"/></td><td><c:out value="${entry.result}"/></td><td><c:out value="${entry.provider}"/></td><td><c:out value="${entry.ip}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></section>
<section class="uv2-panel uv2-danger-zone"><div class="uv2-panel-head"><div><p class="uv2-eyebrow">QUẢN LÝ TÀI KHOẢN</p><h2>Yêu cầu xóa tài khoản</h2><p>Thông tin đơn hàng đã phát sinh vẫn được lưu để phục vụ đối soát; tài khoản sẽ ngừng hoạt động.</p></div></div><form method="post" action="${pageContext.request.contextPath}/profile" class="uv2-form" onsubmit="return confirm('Bạn chắc chắn muốn vô hiệu hóa tài khoản PrintKraft?')"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="deleteAccount"><label>Nhập mật khẩu để xác nhận<input type="password" name="deletePassword" autocomplete="current-password" required maxlength="72"></label><button class="uv2-button is-danger">Xóa tài khoản</button></form></section>
</div></div></main><jsp:include page="/customer/footer.jsp"/></body></html>