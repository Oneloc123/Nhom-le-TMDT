<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khôi phục mật khẩu | PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/user-v2.css"></head>
<body class="uv2-auth-body"><main class="uv2-auth-wrap uv2-auth-single"><section class="uv2-auth-card"><a class="uv2-brand" href="${pageContext.request.contextPath}/home">PrintKraft <span>3D</span></a><p class="uv2-eyebrow">BẢO MẬT TÀI KHOẢN</p><h2>Khôi phục mật khẩu</h2><p class="uv2-muted">Nhập email đã đăng ký để nhận mã xác thực.</p>
<c:if test="${not empty info}"><div class="uv2-alert is-success"><c:out value="${info}"/></div><p class="uv2-small">Môi trường hiện tại đang dùng MailService DEV: mã OTP được ghi vào console của máy chủ. Khi triển khai thật, cần cấu hình SMTP.</p></c:if>
<c:if test="${not empty error}"><div class="uv2-alert is-error"><c:out value="${error}"/></div></c:if>
<c:choose><c:when test="${step eq 'reset'}"><form method="post" action="${pageContext.request.contextPath}/forgot-password" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="reset"><input type="hidden" name="email" value="<c:out value='${email}'/>"><label>Mã OTP 6 chữ số<input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><label>Mật khẩu mới<input type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><label>Nhập lại mật khẩu<input type="password" name="confirmPassword" minlength="8" maxlength="72" autocomplete="new-password" required></label><button class="uv2-button is-primary">Đặt lại mật khẩu</button></form></c:when>
<c:otherwise><form method="post" action="${pageContext.request.contextPath}/forgot-password" class="uv2-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="send"><label>Email<input type="email" name="email" maxlength="190" required value="<c:out value='${email}'/>" autocomplete="email"></label><button class="uv2-button is-primary">Gửi mã khôi phục</button></form></c:otherwise></c:choose>
<p class="uv2-auth-switch"><a href="${pageContext.request.contextPath}/login">Quay lại đăng nhập</a></p></section></main></body></html>
