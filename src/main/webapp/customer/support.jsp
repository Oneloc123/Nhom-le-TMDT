<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Hỗ trợ - PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/cus_home.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><script src="${pageContext.request.contextPath}/js/account.js" defer></script></head><body class="customer-account-body"><%@ include file="header.jsp" %><jsp:include page="sidebar.jsp" /><main class="account-page"><div class="shop-heading"><div><div class="eyebrow-line">Chăm sóc khách hàng</div><h1>Hỗ trợ và khiếu nại</h1><p>Tạo ticket để liên hệ đội ngũ PrintKraft; lịch sử trao đổi được lưu trong tài khoản.</p></div></div><c:if test="${not empty error}"><div class="alert alert-err" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${param.created == '1'}"><div class="alert alert-ok" role="status">Ticket đã được tạo.</div></c:if><c:if test="${param.replied == '1' or param.reopened == '1' or param.rated == '1'}"><div class="alert alert-ok" role="status">Yêu cầu đã được cập nhật.</div></c:if>
<div class="account-content" style="display:grid;grid-template-columns: minmax(0,1fr) minmax(280px,.8fr);gap:18px;align-items:start"><section class="panel account-panel"><div class="panel-head account-panel-head"><div><span class="panel-kicker">TICKET CỦA BẠN</span><h2>Danh sách yêu cầu</h2></div></div><c:choose><c:when test="${empty tickets}"><p>Bạn chưa tạo yêu cầu hỗ trợ nào.</p></c:when><c:otherwise><div class="account-message-stream"><c:forEach var="t" items="${tickets}"><article class="account-message-row"><div class="account-message-meta"><c:out value="${t.code}"/> · <c:out value="${t.createdAt}"/></div><h3><c:out value="${t.subject}"/></h3><p><c:out value="${t.category}"/> · <b><c:out value="${t.status}"/></b> · Ưu tiên <c:out value="${t.priority}"/></p><a class="account-outline-button" href="${pageContext.request.contextPath}/support?id=${t.id}">Xem hội thoại</a></article></c:forEach></div></c:otherwise></c:choose></section>
<section class="panel account-panel"><div class="panel-head account-panel-head"><div><span class="panel-kicker">YÊU CẦU MỚI</span><h2>Tạo ticket</h2></div></div><form method="post" action="${pageContext.request.contextPath}/support" class="stack-form account-form"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="create"><label>Loại yêu cầu<select name="category" required><option value="SUPPORT">Hỗ trợ</option><option value="COMPLAINT">Khiếu nại</option><option value="REFUND">Hoàn tiền</option><option value="PAYMENT">Thanh toán</option><option value="QUALITY">Chất lượng sản phẩm</option><option value="SHIPPING">Vận chuyển</option><option value="ACCOUNT">Tài khoản</option><option value="OTHER">Khác</option></select></label><label>Đơn hàng liên quan (không bắt buộc)<select name="orderId"><option value="">Không chọn đơn hàng</option><c:forEach var="o" items="${orders}"><option value="${o.id}"><c:out value="${o.code}"/> · <c:out value="${o.status}"/></option></c:forEach></select></label><label>Tiêu đề<input type="text" name="subject" maxlength="180" required></label><label>Mức ưu tiên<select name="priority"><option value="LOW">Thấp</option><option value="NORMAL" selected>Bình thường</option><option value="HIGH">Cao</option></select></label><label>Nội dung<textarea name="message" rows="5" minlength="10" maxlength="5000" required></textarea></label><button class="btn-primary" type="submit">Gửi yêu cầu</button></form></section></div>
<c:if test="${not empty ticket}"><section class="panel account-panel" style="margin-top:18px"><div class="panel-head account-panel-head"><div><span class="panel-kicker"><c:out value="${ticket.code}"/></span><h2><c:out value="${ticket.subject}"/></h2><p>Trạng thái: <b><c:out value="${ticket.status}"/></b></p></div></div><div class="account-ticket-chat"><c:forEach var="m" items="${ticketMessages}"><article class="account-ticket-message"><b><c:out value="${m.sender}"/></b><div class="account-message-meta"><c:out value="${m.createdAt}"/></div><p><c:out value="${m.body}"/></p></article></c:forEach></div><c:if test="${ticket.status != 'CLOSED'}"><form method="post" action="${pageContext.request.contextPath}/support" class="stack-form account-form"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="reply"><input type="hidden" name="ticketId" value="${ticket.id}"><label>Phản hồi<textarea name="message" maxlength="5000" rows="3" required></textarea></label><button class="btn-primary" type="submit">Gửi phản hồi</button></form></c:if><c:if test="${ticket.status == 'CLOSED' or ticket.status == 'RESOLVED'}"><form method="post" action="${pageContext.request.contextPath}/support" class="account-shortcuts"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="reopen"><input type="hidden" name="ticketId" value="${ticket.id}"><button class="account-outline-button" type="submit">Mở lại ticket (trong 7 ngày)</button></form><form method="post" action="${pageContext.request.contextPath}/support" class="account-shortcuts"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="rate"><input type="hidden" name="ticketId" value="${ticket.id}"><label>Đánh giá hỗ trợ<select name="rating"><option value="5">5 - Rất hài lòng</option><option value="4">4 - Hài lòng</option><option value="3">3 - Bình thường</option><option value="2">2 - Chưa hài lòng</option><option value="1">1 - Không hài lòng</option></select></label><button class="account-outline-button" type="submit">Gửi đánh giá</button></form></c:if></section></c:if>
</main></body></html>
