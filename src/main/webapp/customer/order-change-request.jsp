<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Yêu cầu thay đổi đơn - PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/cus_home.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"><script src="${pageContext.request.contextPath}/js/order-change-request.js" defer></script></head>
<body><%@ include file="header.jsp" %><jsp:include page="sidebar.jsp"/><main class="shop-page">
<div class="shop-heading"><div><div class="eyebrow-line">Liên lạc với xưởng</div><h1>Yêu cầu thay đổi / hủy in</h1><p>Yêu cầu được đối chiếu với công đoạn sản xuất hiện tại. Đơn đã sẵn sàng giao cần chuyển qua Hỗ trợ.</p></div><a class="button-secondary" href="${pageContext.request.contextPath}/purchase-history">Lịch sử đơn hàng</a></div>
<c:if test="${not empty error}"><div class="notice-error" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${not empty message}"><div class="notice-ok" role="status"><c:out value="${message}"/></div></c:if>
<c:if test="${not empty selectedOrder}"><section class="account-panel"><h2>Tạo yêu cầu cho đơn <c:out value="${selectedOrder.orderCode}"/></h2><form method="post" action="${pageContext.request.contextPath}/order-change-request" class="account-form-grid" id="changeRequestForm"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="create"><input type="hidden" name="code" value="<c:out value='${selectedOrder.orderCode}'/>">
<label>Loại yêu cầu<select name="requestType" id="changeRequestType" required><option value="CHANGE_MATERIAL">Đổi vật liệu</option><option value="CHANGE_COLOR">Đổi màu</option><option value="CHANGE_QUANTITY">Đổi số lượng</option><option value="REPLACE_DESIGN">Thay file thiết kế</option><option value="CHANGE_ADDRESS">Đổi địa chỉ giao</option><option value="CANCEL_ITEM">Hủy một sản phẩm</option><option value="CANCEL_ORDER">Hủy toàn bộ đơn</option><option value="OTHER">Khác</option></select></label>
<label>Sản phẩm liên quan<select name="orderItemId" id="changeRequestItem"><option value="">Toàn bộ đơn / không gắn sản phẩm</option><c:forEach var="item" items="${selectedItems}"><option value="<c:out value='${item.orderItemId}'/>"><c:out value="${item.productName}"/> — <c:out value="${item.shopName}"/></option></c:forEach></select></label>
<label class="account-form-wide" data-proposal-text>Giá trị muốn đề xuất<input type="text" id="proposalText" maxlength="1800" placeholder="Ví dụ: PLA thay cho ABS, màu đen..."></label>
<label class="account-form-wide" data-proposal-address hidden>Địa chỉ mới<select id="proposalAddress" disabled><c:forEach var="a" items="${addresses}"><option value="<c:out value='${a.addressId}'/>"><c:out value="${a.label}"/> — <c:out value="${a.fullLine}"/></option></c:forEach></select></label><input type="hidden" name="proposedValue" id="proposedValue">
<label class="account-form-wide">Lý do <textarea name="reason" rows="3" maxlength="1000" required placeholder="Mô tả rõ thay đổi cần thực hiện và lý do"></textarea></label><div class="account-form-wide account-form-actions"><button type="submit" class="btn-primary">Gửi yêu cầu</button></div></form>
<p class="account-muted-note">Nếu chưa có cập nhật sản xuất, một số thao tác như hủy đơn hoặc đổi địa chỉ có thể áp dụng ngay. Thay đổi về vật liệu, màu, file hoặc số lượng vẫn cần quy trình xác nhận để tránh thay đổi giá sai lệch.</p></section></c:if>
<section class="account-panel"><h2>Yêu cầu của tôi</h2><c:choose><c:when test="${empty changeRequests}"><p class="account-empty">Bạn chưa gửi yêu cầu thay đổi hoặc hủy in nào.</p></c:when><c:otherwise><div class="account-request-list"><c:forEach var="r" items="${changeRequests}"><article class="account-request-card"><div class="account-request-heading"><div><strong><c:out value="${r.orderCode}"/> · <c:out value="${r.type}"/></strong><small><c:out value="${r.createdAt}"/></small></div><span class="status"><c:out value="${r.status}"/></span></div><p><c:out value="${r.reason}"/></p><c:if test="${not empty r.response}"><p><b>Phản hồi xưởng:</b> <c:out value="${r.response}"/></p></c:if><c:if test="${r.priceDelta != 0}"><p>Chênh lệch giá: <fmt:formatNumber value="${r.priceDelta}" type="number" groupingUsed="true"/>đ</p></c:if><c:if test="${r.cancelFee != 0}"><p>Phí hủy: <fmt:formatNumber value="${r.cancelFee}" type="number" groupingUsed="true"/>đ</p></c:if><div class="account-request-actions"><a class="account-outline-button" href="${pageContext.request.contextPath}/order-change-request?code=${r.orderCode}">Xem đơn</a><c:if test="${r.status == 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/order-change-request"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="withdraw"><input type="hidden" name="requestId" value="<c:out value='${r.id}'/>"><input type="hidden" name="code" value="<c:out value='${r.orderCode}'/>"><button type="submit" class="account-quiet-button">Rút yêu cầu</button></form></c:if><c:if test="${r.status == 'ACCEPTED'}"><form method="post" action="${pageContext.request.contextPath}/order-change-request"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="action" value="confirm"><input type="hidden" name="requestId" value="<c:out value='${r.id}'/>"><input type="hidden" name="code" value="<c:out value='${r.orderCode}'/>"><button type="submit" class="btn-primary">Xác nhận phản hồi</button></form></c:if></div></article></c:forEach></div></c:otherwise></c:choose></section>
</main><%@ include file="footer.jsp" %></body></html>
