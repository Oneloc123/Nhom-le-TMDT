<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tin nhắn xưởng - PrintKraft</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/cus_home.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/account.css"></head><body class="customer-account-body"><%@ include file="header.jsp" %><jsp:include page="sidebar.jsp" /><main class="account-page"><div class="shop-heading"><div><div class="eyebrow-line">Đơn hàng</div><h1>Tin nhắn xưởng</h1><p>Trao đổi với xưởng gắn với từng đơn hàng. Không gửi mật khẩu, OTP hoặc thông tin thẻ thanh toán.</p></div></div><c:if test="${not empty error}"><div class="alert alert-err" role="alert"><c:out value="${error}"/></div></c:if><c:if test="${param.sent == '1'}"><div class="alert alert-ok" role="status">Tin nhắn đã được gửi.</div></c:if>
<div class="account-content" style="display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:18px;align-items:start"><section class="panel account-panel"><div class="panel-head account-panel-head"><div><span class="panel-kicker">HỘI THOẠI</span><h2>Đơn hàng và xưởng</h2></div></div><c:choose><c:when test="${empty threads}"><p>Chưa có đơn hàng gắn với xưởng để bắt đầu hội thoại.</p></c:when><c:otherwise><div class="account-message-stream"><c:forEach var="t" items="${threads}"><article class="account-message-row"><div class="account-message-meta"><c:out value="${t.orderCode}"/> · <c:out value="${t.lastMessageAt}"/></div><h3><c:out value="${t.shopName}"/></h3><p><c:out value="${t.lastMessage}"/></p><c:if test="${t.unread gt 0}"><span class="nav-count"><c:out value="${t.unread}"/> chưa đọc</span></c:if><a class="account-outline-button" href="${pageContext.request.contextPath}/messages?orderId=${t.orderId}&shopId=${t.shopId}">Mở hội thoại</a></article></c:forEach></div></c:otherwise></c:choose></section>
<section class="panel account-panel"><div class="panel-head account-panel-head"><div><span class="panel-kicker">CHI TIẾT HỘI THOẠI</span><h2><c:choose><c:when test="${not empty threadOrderId}">Đơn hàng #<c:out value="${threadOrderId}"/></c:when><c:otherwise>Chọn một hội thoại</c:otherwise></c:choose></h2></div></div><c:choose><c:when test="${empty threadOrderId}"><p>Chọn một hội thoại trong danh sách bên trái để xem tin nhắn và phản hồi xưởng.</p></c:when><c:otherwise><div class="account-ticket-chat"><c:forEach var="m" items="${threadMessages}"><article class="account-ticket-message <c:if test='${m.mine}'>mine</c:if>"><b><c:out value="${m.sender}"/> <c:if test="${m.mine}">(Bạn)</c:if></b><div class="account-message-meta"><c:out value="${m.createdAt}"/></div><p><c:out value="${m.body}"/></p></article></c:forEach></div><form method="post" action="${pageContext.request.contextPath}/messages" class="stack-form account-form"><input type="hidden" name="csrfToken" value="<%= vn.edu.hcmuaf.fit.tmdt_nhomle.util.Csrf.ensureToken(request) %>"><input type="hidden" name="orderId" value="${threadOrderId}"><input type="hidden" name="shopId" value="${threadShopId}"><label>Tin nhắn<textarea name="message" rows="4" maxlength="2000" required placeholder="Hỏi tiến độ hoặc trao đổi về đơn hàng..."></textarea></label><button class="btn-primary" type="submit">Gửi tin nhắn</button></form></c:otherwise></c:choose></section></div></main></body></html>
